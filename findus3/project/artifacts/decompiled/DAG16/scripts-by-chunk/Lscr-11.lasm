global gkalenderintro

on exitFrame
  [  0] pushzero ................................ <0>
  [  1] setglobal 13 ............................ gkalenderintro = 0
  [  3] pushint8 1 .............................. <1>
  [  6] pushcons 0 .............................. <"KONSTR01">
  [  8] pusharglistnoret 2 ...................... <1, "KONSTR01">
  [ 10] extcall 1 ............................... go(1, "KONSTR01")
  [ 12] ret
end
