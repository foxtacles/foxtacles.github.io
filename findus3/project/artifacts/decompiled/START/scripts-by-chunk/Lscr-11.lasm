on exitFrame
  [  0] getmovieprop 13 ......................... <the moviePath>
  [  2] pushint8 12 ............................. <12>
  [  5] get 0 ................................... <the last char in the moviePath>
  [  7] setlocal 0 .............................. separator = the last char in the moviePath
  [  9] pushint8 1 .............................. <1>
  [ 12] getmovieprop 13 ......................... <the moviePath>
  [ 14] pushcons 0 .............................. <"main">
  [ 16] joinstr ................................. <the moviePath & "main">
  [ 17] getlocal 0 .............................. <separator>
  [ 19] joinstr ................................. <the moviePath & "main" & separator>
  [ 20] pushcons 8 .............................. <"intro">
  [ 22] joinstr ................................. <the moviePath & "main" & separator & "intro">
  [ 23] pusharglistnoret 2 ...................... <1, the moviePath & "main" & separator & "intro">
  [ 25] extcall 1 ............................... go(1, the moviePath & "main" & separator & "intro")
  [ 27] ret
end
