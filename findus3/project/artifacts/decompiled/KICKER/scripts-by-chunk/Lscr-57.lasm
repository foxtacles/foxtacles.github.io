on exitFrame
  [  0] pusharglist 0 ........................... <>
  [  2] thebuiltin 37 ........................... <the pathName>
  [  5] setlocal 0 .............................. dp = the pathName
  [  7] getlocal 0 .............................. <dp>
  [  9] pusharglist 1 ........................... <dp>
  [ 11] extcall 40 .............................. <length(dp)>
  [ 14] pushzero ................................ <0>
  [ 15] pushzero ................................ <0>
  [ 16] pushzero ................................ <0>
  [ 17] pushzero ................................ <0>
  [ 18] pushzero ................................ <0>
  [ 19] pushzero ................................ <0>
  [ 20] pushzero ................................ <0>
  [ 21] getlocal 0 .............................. <dp>
  [ 23] getchunk ................................ <char length(dp) of dp>
  [ 24] pushcons 0 .............................. <"\\">
  [ 26] eq ...................................... <char length(dp) of dp = "\\">
  [ 27] jmpifz [ 55] ............................ if char length(dp) of dp = "\\" then
  [ 30] pushint8 1 .............................. <1>
  [ 33] getlocal 0 .............................. <dp>
  [ 35] pusharglist 1 ........................... <dp>
  [ 37] extcall 40 .............................. <length(dp)>
  [ 40] pushint8 1 .............................. <1>
  [ 43] sub ..................................... <length(dp) - 1>
  [ 44] pushzero ................................ <0>
  [ 45] pushzero ................................ <0>
  [ 46] pushzero ................................ <0>
  [ 47] pushzero ................................ <0>
  [ 48] pushzero ................................ <0>
  [ 49] pushzero ................................ <0>
  [ 50] getlocal 0 .............................. <dp>
  [ 52] getchunk ................................ <char 1 to (length(dp) - 1) of dp>
  [ 53] setlocal 0 .............................. dp = char 1 to (length(dp) - 1) of dp
  [ 55] pusharglist 0 ........................... <>
  [ 57] thebuiltin 2 ............................ <the machineType>
  [ 59] pushint8 256 ............................ <256>
  [ 62] eq ...................................... <the machineType = 256>
  [ 63] jmpifz [ 80] ............................ if the machineType = 256 then / else
  [ 66] getlocal 0 .............................. <dp>
  [ 68] pushcons 8 .............................. <"\\main">
  [ 70] joinstr ................................. <dp & "\\main">
  [ 71] pusharglist 1 ........................... <[dp & "\\main"]>
  [ 73] pushlist ................................ <[dp & "\\main"]>
  [ 74] setmovieprop 38 ......................... the searchPaths = [dp & "\\main"]
  [ 77] jmp [ 91]
  [ 80] getlocal 0 .............................. <dp>
  [ 82] pushcons 16 ............................. <":main">
  [ 84] joinstr ................................. <dp & ":main">
  [ 85] pusharglist 1 ........................... <[dp & ":main"]>
  [ 87] pushlist ................................ <[dp & ":main"]>
  [ 88] setmovieprop 38 ......................... the searchPaths = [dp & ":main"]
  [ 91] ret
end
