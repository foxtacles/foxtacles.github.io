  [ 58] extcall 50 .............................. addAt(lista, count(lista) + 1, varde)
  [ 60] endrepeat [ 31]
  [ 62] getparam 0 .............................. <lista>
  [ 64] pusharglistnoret 1 ...................... <lista>
  [ 66] extcall 22 .............................. return lista
  [ 68] ret
end
