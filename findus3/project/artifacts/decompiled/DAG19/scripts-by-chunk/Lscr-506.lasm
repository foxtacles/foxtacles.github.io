on nolla_curs first, last
  [  0] getparam 0 .............................. <first>
  [  2] setlocal 0
  [  4] getlocal 0
  [  6] getparam 8 .............................. <last>
  [  8] lteq
  [  9] jmpifz [ 28] ............................ repeat with X = first to last
  [ 12] getlocal 0 .............................. <X>
  [ 14] pushzero ................................ <0>
  [ 15] pushint8 6 .............................. <6>
  [ 17] set 6 ................................... set the cursor of sprite X to 0
  [ 19] pushint8 1
  [ 21] getlocal 0
  [ 23] add
  [ 24] setlocal 0
  [ 26] endrepeat [  4]
  [ 28] ret
end

on puppets_off first, last
  [  0] getparam 0 .............................. <first>
  [  2] setlocal 0
  [  4] getlocal 0
  [  6] getparam 8 .............................. <last>
  [  8] lteq
  [  9] jmpifz [ 28] ............................ repeat with X = first to last
  [ 12] getlocal 0 .............................. <X>
  [ 14] pushzero ................................ <0>
  [ 15] pusharglistnoret 2 ...................... <X, 0>
  [ 17] extcall 37 .............................. puppetSprite(X, 0)
  [ 19] pushint8 1
  [ 21] getlocal 0
  [ 23] add
  [ 24] setlocal 0
  [ 26] endrepeat [  4]
  [ 28] ret
end

on puppets_on first, last
  [  0] getparam 0 .............................. <first>
  [  2] setlocal 0
  [  4] getlocal 0
  [  6] getparam 8 .............................. <last>
  [  8] lteq
  [  9] jmpifz [ 29] ............................ repeat with X = first to last
  [ 12] getlocal 0 .............................. <X>
  [ 14] pushint8 1 .............................. <1>
  [ 16] pusharglistnoret 2 ...................... <X, 1>
  [ 18] extcall 37 .............................. puppetSprite(X, 1)
  [ 20] pushint8 1
  [ 22] getlocal 0
  [ 24] add
  [ 25] setlocal 0
  [ 27] endrepeat [  4]
  [ 29] ret
end

on visible_on first, last
  [  0] getparam 0 .............................. <first>
  [  2] setlocal 0
  [  4] getlocal 0
  [  6] getparam 8 .............................. <last>
  [  8] lteq
  [  9] jmpifz [ 29] ............................ repeat with X = first to last
  [ 12] getlocal 0 .............................. <X>
  [ 14] pushint8 1 .............................. <1>
  [ 16] pushint8 25 ............................. <25>
  [ 18] set 6 ................................... set the visible of sprite X to 1
  [ 20] pushint8 1
  [ 22] getlocal 0
  [ 24] add
  [ 25] setlocal 0
  [ 27] endrepeat [  4]
  [ 29] ret
end

on visible_off first, last
  [  0] getparam 0 .............................. <first>
  [  2] setlocal 0
  [  4] getlocal 0
  [  6] getparam 8 .............................. <last>
  [  8] lteq
  [  9] jmpifz [ 28] ............................ repeat with X = first to last
  [ 12] getlocal 0 .............................. <X>
  [ 14] pushzero ................................ <0>
  [ 15] pushint8 25 ............................. <25>
  [ 17] set 6 ................................... set the visible of sprite X to 0
  [ 19] pushint8 1
  [ 21] getlocal 0
  [ 23] add
  [ 24] setlocal 0
  [ 26] endrepeat [  4]
  [ 28] ret
end
