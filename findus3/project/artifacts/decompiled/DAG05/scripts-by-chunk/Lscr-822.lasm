on exitFrame
  [  0] pushzero ................................ <0>
  [  1] setglobal 13 ............................ flash = 0
  [  3] pushint8 1 .............................. <1>
  [  6] setglobal 18 ............................ FirstTime = 1
  [  8] pushint8 2 .............................. <2>
  [ 11] pushint8 255 ............................ <255>
  [ 14] pushint8 1 .............................. <1>
  [ 17] set 4 ................................... set the volume of sound 2 to 255
  [ 19] pushint8 9 .............................. <9>
  [ 22] pusharglistnoret 1 ...................... <9>
  [ 24] extcall 15 .............................. puppetTransition(9)
  [ 26] pushcons 0 .............................. <"rim">
  [ 28] pusharglistnoret 1 ...................... <"rim">
  [ 30] extcall 16 .............................. puppetSound("rim")
  [ 32] pushint8 1 .............................. <1>
  [ 35] setglobal 21 ............................ G_SpikFirstTime = 1
  [ 37] ret
end
