global gBorja, flash, G_SpikFirstTime

on beginSprite me
  [  0] getparam 0 .............................. <me>
  [  2] getobjprop 5 ............................ <me.spriteNum>
  [  4] setglobal 8 ............................. gBorja = me.spriteNum
  [  6] getglobal 8 ............................. <gBorja>
  [  8] pusharglist 1 ........................... <gBorja>
  [ 10] extcall 10 .............................. <sprite(gBorja)>
  [ 12] pushzero ................................ <0>
  [ 13] setobjprop 25 ........................... sprite(gBorja).blend = 0
  [ 15] ret
end

on mouseEnter me
  [  0] getglobal 8 ............................. <gBorja>
  [  2] pusharglist 1 ........................... <gBorja>
  [  4] extcall 10 .............................. <sprite(gBorja)>
  [  6] pushint8 100 ............................ <100>
  [  9] setobjprop 25 ........................... sprite(gBorja).blend = 100
  [ 11] pushint8 31 ............................. <31>
  [ 14] pushint8 32 ............................. <32>
  [ 17] pusharglist 2 ........................... <[31, 32]>
  [ 19] pushlist ................................ <[31, 32]>
  [ 20] pusharglistnoret 1 ...................... <[31, 32]>
  [ 22] extcall 26 .............................. cursor([31, 32])
  [ 24] ret
end

on mouseLeave me
  [  0] getglobal 8 ............................. <gBorja>
  [  2] pusharglist 1 ........................... <gBorja>
  [  4] extcall 10 .............................. <sprite(gBorja)>
  [  6] pushzero ................................ <0>
  [  7] setobjprop 25 ........................... sprite(gBorja).blend = 0
  [  9] pushint8 1 .............................. <1>
  [ 12] inv ..................................... <-1>
  [ 13] pusharglistnoret 1 ...................... <-1>
  [ 15] extcall 26 .............................. cursor(-1)
  [ 17] ret
end

on mouseDown me
  [  0] pusharglist 0 ........................... <>
  [  2] thebuiltin 12 ........................... <the mouseDown>
  [  4] getglobal 13 ............................ <flash>
  [  6] pushzero ................................ <0>
  [  7] eq ...................................... <flash = 0>
  [  8] and ..................................... <the mouseDown and (flash = 0)>
  [  9] jmpifz [ 69] ............................ if the mouseDown and (flash = 0) then
  [ 12] pushint8 1 .............................. <1>
  [ 15] inv ..................................... <-1>
  [ 16] pusharglistnoret 1 ...................... <-1>
  [ 18] extcall 26 .............................. cursor(-1)
  [ 20] pushint8 1 .............................. <1>
  [ 23] setglobal 21 ............................ G_SpikFirstTime = 1
  [ 25] pusharglist 0 ........................... <>
  [ 27] thebuiltin 12 ........................... <the mouseDown>
  [ 29] pushint8 1 .............................. <1>
  [ 32] eq ...................................... <the mouseDown = 1>
  [ 33] jmpifz [ 42] ............................ repeat while the mouseDown = 1
  [ 36] pusharglistnoret 0 ...................... <>
  [ 38] extcall 14 .............................. updateStage()
  [ 40] endrepeat [ 25]
  [ 42] pushint8 1 .............................. <1>
  [ 45] pushzero ................................ <0>
  [ 46] pusharglistnoret 2 ...................... <1, 0>
  [ 48] extcall 16 .............................. puppetSound(1, 0)
  [ 50] getglobal 8 ............................. <gBorja>
  [ 52] pusharglist 1 ........................... <gBorja>
  [ 54] extcall 10 .............................. <sprite(gBorja)>
  [ 56] pushzero ................................ <0>
  [ 57] setobjprop 25 ........................... sprite(gBorja).blend = 0
  [ 59] pusharglistnoret 0 ...................... <>
  [ 61] extcall 14 .............................. updateStage()
  [ 63] pushcons 0 .............................. <"spielen">
  [ 65] pusharglistnoret 1 ...................... <"spielen">
  [ 67] extcall 17 .............................. go("spielen")
  [ 69] ret
end
