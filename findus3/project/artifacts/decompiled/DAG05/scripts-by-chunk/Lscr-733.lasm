on setRegPoint startM, stopM
  [  0] pushint8 125 ............................ <125>
  [  3] setlocal 0 .............................. X = 125
  [  5] pushint8 15 ............................. <15>
  [  8] inv ..................................... <-15>
  [  9] setlocal 8 .............................. Y = -15
  [ 11] getparam 0 .............................. <startM>
  [ 13] setlocal 16
  [ 15] getlocal 16
  [ 17] getparam 8 .............................. <stopM>
  [ 19] lteq
  [ 20] jmpifz [ 95] ............................ repeat with m = startM to stopM
  [ 23] getlocal 16 ............................. <m>
  [ 25] pusharglist 1 ........................... <m>
  [ 27] extcall 82 .............................. <member(m)>
  [ 30] getobjprop 118 .......................... <member(m).regPoint>
  [ 33] setlocal 24 ............................. temp = member(m).regPoint
  [ 35] getlocal 24 ............................. <temp>
  [ 37] pushint8 1 .............................. <1>
  [ 40] pusharglist 2 ........................... <temp, 1>
  [ 42] extcall 43 .............................. <getAt(temp, 1)>
  [ 45] setlocal 32 ............................. t1 = getAt(temp, 1)
  [ 47] getlocal 24 ............................. <temp>
  [ 49] pushint8 2 .............................. <2>
  [ 52] pusharglist 2 ........................... <temp, 2>
  [ 54] extcall 43 .............................. <getAt(temp, 2)>
  [ 57] setlocal 40 ............................. t2 = getAt(temp, 2)
  [ 59] getlocal 16 ............................. <m>
  [ 61] pusharglist 1 ........................... <m>
  [ 63] extcall 82 .............................. <member(m)>
  [ 66] getlocal 32 ............................. <t1>
  [ 68] getlocal 0 .............................. <X>
  [ 70] add ..................................... <t1 + X>
  [ 71] getlocal 40 ............................. <t2>
  [ 73] getlocal 8 .............................. <Y>
  [ 75] add ..................................... <t2 + Y>
  [ 76] pusharglist 2 ........................... <t1 + X, t2 + Y>
  [ 78] extcall 36 .............................. <point(t1 + X, t2 + Y)>
  [ 81] setobjprop 118 .......................... member(m).regPoint = point(t1 + X, t2 + Y)
  [ 84] pushint8 1
  [ 87] getlocal 16
  [ 89] add
  [ 90] setlocal 16
  [ 92] endrepeat [ 15]
  [ 95] ret
end
