global gBorja

on enterFrame
  [  0] getglobal 8 ............................. <gBorja>
  [  2] pusharglist 1 ........................... <gBorja>
  [  4] extcall 10 .............................. <sprite(gBorja)>
  [  6] pushzero ................................ <0>
  [  7] setobjprop 11 ........................... sprite(gBorja).visible = 0
  [  9] ret
end
