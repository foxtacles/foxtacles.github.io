global gKalender, flash

on beginSprite me
  [  0] getparam 0 .............................. <me>
  [  2] getobjprop 5 ............................ <me.spriteNum>
  [  4] setglobal 4 ............................. gKalender = me.spriteNum
  [  6] getglobal 4 ............................. <gKalender>
  [  8] pusharglist 1 ........................... <gKalender>
  [ 10] extcall 10 .............................. <sprite(gKalender)>
  [ 12] pushzero ................................ <0>
  [ 13] setobjprop 25 ........................... sprite(gKalender).blend = 0
  [ 15] ret
end

on mouseEnter me
  [  0] getglobal 4 ............................. <gKalender>
  [  2] pusharglist 1 ........................... <gKalender>
  [  4] extcall 10 .............................. <sprite(gKalender)>
  [  6] pushint8 100 ............................ <100>
  [  9] setobjprop 25 ........................... sprite(gKalender).blend = 100
  [ 11] pushint8 31 ............................. <31>
  [ 14] pushint8 32 ............................. <32>
  [ 17] pusharglist 2 ........................... <[31, 32]>
  [ 19] pushlist ................................ <[31, 32]>
  [ 20] pusharglistnoret 1 ...................... <[31, 32]>
  [ 22] extcall 26 .............................. cursor([31, 32])
  [ 24] ret
end

on mouseLeave me
  [  0] getglobal 4 ............................. <gKalender>
  [  2] pusharglist 1 ........................... <gKalender>
  [  4] extcall 10 .............................. <sprite(gKalender)>
  [  6] pushzero ................................ <0>
  [  7] setobjprop 25 ........................... sprite(gKalender).blend = 0
  [  9] pushint8 1 .............................. <1>
  [ 12] inv ..................................... <-1>
  [ 13] pusharglistnoret 1 ...................... <-1>
  [ 15] extcall 26 .............................. cursor(-1)
  [ 17] ret
end

on mouseDown me
  [  0] pusharglist 0 ........................... <>
  [  2] thebuiltin 12 ........................... <the mouseDown>
  [  4] getglobal 13 ............................ <flash>
  [  6] pushzero ................................ <0>
  [  7] eq ...................................... <flash = 0>
  [  8] and ..................................... <the mouseDown and (flash = 0)>
  [  9] jmpifz [ 58] ............................ if the mouseDown and (flash = 0) then
  [ 12] pushint8 1 .............................. <1>
  [ 15] inv ..................................... <-1>
  [ 16] pusharglistnoret 1 ...................... <-1>
  [ 18] extcall 26 .............................. cursor(-1)
  [ 20] pusharglist 0 ........................... <>
  [ 22] thebuiltin 12 ........................... <the mouseDown>
  [ 24] pushint8 1 .............................. <1>
  [ 27] eq ...................................... <the mouseDown = 1>
  [ 28] jmpifz [ 37] ............................ repeat while the mouseDown = 1
  [ 31] pusharglistnoret 0 ...................... <>
  [ 33] extcall 14 .............................. updateStage()
  [ 35] endrepeat [ 20]
  [ 37] pushint8 10 ............................. <10>
  [ 40] pusharglistnoret 1 ...................... <10>
  [ 42] extcall 15 .............................. puppetTransition(10)
  [ 44] pushint8 1 .............................. <1>
  [ 47] pushzero ................................ <0>
  [ 48] pusharglistnoret 2 ...................... <1, 0>
  [ 50] extcall 16 .............................. puppetSound(1, 0)
  [ 52] pushcons 0 .............................. <"spelslut">
  [ 54] pusharglistnoret 1 ...................... <"spelslut">
  [ 56] extcall 17 .............................. go("spelslut")
  [ 58] ret
end
