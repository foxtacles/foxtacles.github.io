global MasterVolym

on FixaVolym Avsnitt, Typ
  [  0] getparam 8 .............................. <Typ>
  [  2] pushint8 1 .............................. <1>
  [  5] eq ...................................... <Typ = 1>
  [  6] jmpifz [ 19] ............................ if Typ = 1 then
  [  9] getglobal 115 ........................... <MasterVolym>
  [ 12] pushint8 25 ............................. <25>
  [ 15] add ..................................... <MasterVolym + 25>
  [ 16] setglobal 115 ........................... MasterVolym = MasterVolym + 25
  [ 19] getparam 8 .............................. <Typ>
  [ 21] pushint8 1 .............................. <1>
  [ 24] inv ..................................... <-1>
  [ 25] eq ...................................... <Typ = -1>
  [ 26] jmpifz [ 39] ............................ if Typ = -1 then
  [ 29] getglobal 115 ........................... <MasterVolym>
  [ 32] pushint8 25 ............................. <25>
  [ 35] sub ..................................... <MasterVolym - 25>
  [ 36] setglobal 115 ........................... MasterVolym = MasterVolym - 25
  [ 39] getglobal 115 ........................... <MasterVolym>
  [ 42] pushint8 255 ............................ <255>
  [ 45] gt ...................................... <MasterVolym > 255>
  [ 46] jmpifz [ 55] ............................ if MasterVolym > 255 then
  [ 49] pushint8 255 ............................ <255>
  [ 52] setglobal 115 ........................... MasterVolym = 255
  [ 55] getglobal 115 ........................... <MasterVolym>
  [ 58] pushint8 40 ............................. <40>
  [ 61] lt ...................................... <MasterVolym < 40>
  [ 62] jmpifz [ 71] ............................ if MasterVolym < 40 then
  [ 65] pushint8 40 ............................. <40>
  [ 68] setglobal 115 ........................... MasterVolym = 40
  [ 71] pushint8 120 ............................ <120>
  [ 74] setlocal 0 .............................. MusikLevel = 120
  [ 76] getlocal 0 .............................. <MusikLevel>
  [ 78] getglobal 115 ........................... <MasterVolym>
  [ 81] pushcons 0 .............................. <255.0>
  [ 83] div ..................................... <MasterVolym / 255.0>
  [ 84] mul ..................................... <MusikLevel * (MasterVolym / 255.0)>
  [ 85] setlocal 8 .............................. NyLevel = MusikLevel * (MasterVolym / 255.0)
  [ 87] pushint8 1 .............................. <1>
  [ 90] getglobal 115 ........................... <MasterVolym>
  [ 93] pushint8 1 .............................. <1>
  [ 96] set 4 ................................... set the volume of sound 1 to MasterVolym
  [ 98] pushint8 2 .............................. <2>
  [101] getglobal 115 ........................... <MasterVolym>
  [104] pushint8 1 .............................. <1>
  [107] set 4 ................................... set the volume of sound 2 to MasterVolym
  [109] pushint8 3 .............................. <3>
  [112] getglobal 115 ........................... <MasterVolym>
  [115] pushint8 1 .............................. <1>
  [118] set 4 ................................... set the volume of sound 3 to MasterVolym
  [120] getparam 0 .............................. <Avsnitt>
  [122] pushint8 1 .............................. <1>
  [125] eq ...................................... <Avsnitt = 1>
  [126] jmpifz [142] ............................ if Avsnitt = 1 then / else
  [129] pushint8 4 .............................. <4>
  [132] getlocal 8 .............................. <NyLevel>
  [134] pushint8 1 .............................. <1>
  [137] set 4 ................................... set the volume of sound 4 to NyLevel
  [139] jmp [153]
  [142] pushint8 4 .............................. <4>
  [145] getglobal 115 ........................... <MasterVolym>
  [148] pushint8 1 .............................. <1>
  [151] set 4 ................................... set the volume of sound 4 to MasterVolym
  [153] ret
end
