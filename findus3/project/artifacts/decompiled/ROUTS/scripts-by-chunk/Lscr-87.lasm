on StartaUtLjud LjudSt
  [  0] getglobal 10 ............................ <G_AktGame>
  [  2] pushint8 2 .............................. <2>
  [  5] eq ...................................... <G_AktGame = 2>
  [  6] jmpifz [ 20] ............................ if G_AktGame = 2 then / else
  [  9] pushint8 4 .............................. <4>
  [ 12] pusharglistnoret 1 ...................... <4>
  [ 14] extcall 48 .............................. RensaLjud(4)
  [ 17] jmp [ 25]
  [ 20] pusharglistnoret 0 ...................... <>
  [ 22] extcall 48 .............................. RensaLjud()
  [ 25] pushint8 1 .............................. <1>
  [ 28] getparam 0 .............................. <LjudSt>
  [ 30] pusharglistnoret 2 ...................... <1, LjudSt>
  [ 32] extcall 49 .............................. puppetSound(1, LjudSt)
  [ 35] pusharglist 0 ........................... <>
  [ 37] thebuiltin 50 ........................... <the mouseDown>
  [ 40] pushint8 1 .............................. <1>
  [ 43] eq ...................................... <the mouseDown = 1>
  [ 44] jmpifz [ 49] ............................ repeat while the mouseDown = 1
  [ 47] endrepeat [ 35]
  [ 49] pushint8 1 .............................. <1>
  [ 52] pusharglist 1 ........................... <1>
  [ 54] extcall 75 .............................. <soundBusy(1)>
  [ 57] pushint8 1 .............................. <1>
  [ 60] eq ...................................... <soundBusy(1) = 1>
  [ 61] jmpifz [ 88] ............................ repeat while soundBusy(1) = 1
  [ 64] pusharglist 0 ........................... <>
  [ 66] thebuiltin 50 ........................... <the mouseDown>
  [ 69] pushint8 1 .............................. <1>
  [ 72] eq ...................................... <the mouseDown = 1>
  [ 73] jmpifz [ 85] ............................ if the mouseDown = 1 then
  [ 76] pushint8 1 .............................. <1>
  [ 79] pushzero ................................ <0>
  [ 80] pusharglistnoret 2 ...................... <1, 0>
  [ 82] extcall 49 .............................. puppetSound(1, 0)
  [ 85] endrepeat [ 49]
  [ 88] pusharglist 0 ........................... <>
  [ 90] thebuiltin 50 ........................... <the mouseDown>
  [ 93] pushint8 1 .............................. <1>
  [ 96] eq ...................................... <the mouseDown = 1>
  [ 97] jmpifz [102] ............................ repeat while the mouseDown = 1
  [100] endrepeat [ 88]
  [102] ret
end
