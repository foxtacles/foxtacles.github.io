on BackupList SourceList
  [  0] pusharglist 0 ........................... <[]>
  [  2] pushlist ................................ <[]>
  [  3] setlocal 0 .............................. DestList = []
  [  5] pushint8 1 .............................. <1>
  [  7] setlocal 8
  [  9] getlocal 8
  [ 11] getparam 0 .............................. <SourceList>
  [ 13] pusharglist 1 ........................... <SourceList>
  [ 15] extcall 123 ............................. <count(SourceList)>
  [ 17] lteq
  [ 18] jmpifz [ 46] ............................ repeat with i = 1 to count(SourceList)
  [ 21] getlocal 0 .............................. <DestList>
  [ 23] getlocal 8 .............................. <i>
  [ 25] getparam 0 .............................. <SourceList>
  [ 27] getlocal 8 .............................. <i>
  [ 29] pusharglist 2 ........................... <SourceList, i>
  [ 31] extcall 53 .............................. <getAt(SourceList, i)>
  [ 33] pusharglistnoret 3 ...................... <DestList, i, getAt(SourceList, i)>
  [ 35] extcall 96 .............................. setAt(DestList, i, getAt(SourceList, i))
  [ 37] pushint8 1
  [ 39] getlocal 8
  [ 41] add
  [ 42] setlocal 8
  [ 44] endrepeat [  9]
  [ 46] getlocal 0 .............................. <DestList>
  [ 48] pusharglistnoret 1 ...................... <DestList>
  [ 50] extcall 119 ............................. return DestList
  [ 52] ret
end
