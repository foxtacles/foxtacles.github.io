on ChangeToStage SpritNr
  [  0] getparam 0 .............................. <SpritNr>
  [  2] pushint8 18 ............................. <18>
  [  4] eq ...................................... <SpritNr = 18>
  [  5] jmpifz [ 17] ............................ if SpritNr = 18 then
  [  8] getparam 0 .............................. <SpritNr>
  [ 10] pushint8 415 ............................ <415>
  [ 13] pushint8 4 .............................. <4>
  [ 15] set 6 ................................... set the castNum of sprite SpritNr to 415
  [ 17] getparam 0 .............................. <SpritNr>
  [ 19] pushint8 20 ............................. <20>
  [ 21] eq ...................................... <SpritNr = 20>
  [ 22] jmpifz [ 34] ............................ if SpritNr = 20 then
  [ 25] getparam 0 .............................. <SpritNr>
  [ 27] pushint8 485 ............................ <485>
  [ 30] pushint8 4 .............................. <4>
  [ 32] set 6 ................................... set the castNum of sprite SpritNr to 485
  [ 34] ret
end
