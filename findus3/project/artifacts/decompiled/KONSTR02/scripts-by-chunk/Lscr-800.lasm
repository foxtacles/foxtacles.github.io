on exitFrame
  [  0] getglobal 128 ........................... <NyAvsnitt>
  [  3] pushint8 1 .............................. <1>
  [  6] eq ...................................... <NyAvsnitt = 1>
  [  7] jmpifz [ 19] ............................ if NyAvsnitt = 1 then
  [ 10] pushint8 1 .............................. <1>
  [ 13] pushcons 0 .............................. <"PINTRO">
  [ 15] pusharglistnoret 2 ...................... <1, "PINTRO">
  [ 17] extcall 26 .............................. go(1, "PINTRO")
  [ 19] getglobal 128 ........................... <NyAvsnitt>
  [ 22] pushint8 2 .............................. <2>
  [ 25] eq ...................................... <NyAvsnitt = 2>
  [ 26] getglobal 24 ............................ <AktRitning>
  [ 28] pushzero ................................ <0>
  [ 29] gt ...................................... <AktRitning > 0>
  [ 30] and ..................................... <(NyAvsnitt = 2) and (AktRitning > 0)>
  [ 31] jmpifz [ 80] ............................ if (NyAvsnitt = 2) and (AktRitning > 0) then
  [ 34] getglobal 24 ............................ <AktRitning>
  [ 36] pusharglist 1 ........................... <AktRitning>
  [ 38] extcall 129 ............................. <string(AktRitning)>
  [ 41] setlocal 0 .............................. Kstr = string(AktRitning)
  [ 43] getlocal 0 .............................. <Kstr>
  [ 45] pusharglist 1 ........................... <Kstr>
  [ 47] extcall 130 ............................. <length(Kstr)>
  [ 50] pushint8 1 .............................. <1>
  [ 53] eq ...................................... <length(Kstr) = 1>
  [ 54] jmpifz [ 64] ............................ if length(Kstr) = 1 then
  [ 57] pushcons 8 .............................. <"0">
  [ 59] getlocal 0 .............................. <Kstr>
  [ 61] joinstr ................................. <"0" & Kstr>
  [ 62] setlocal 0 .............................. Kstr = "0" & Kstr
  [ 64] pushcons 16 ............................. <"KONSTR">
  [ 66] getlocal 0 .............................. <Kstr>
  [ 68] joinstr ................................. <"KONSTR" & Kstr>
  [ 69] setlocal 0 .............................. Kstr = "KONSTR" & Kstr
  [ 71] pushint8 1 .............................. <1>
  [ 74] getlocal 0 .............................. <Kstr>
  [ 76] pusharglistnoret 2 ...................... <1, Kstr>
  [ 78] extcall 26 .............................. go(1, Kstr)
  [ 80] ret
end
