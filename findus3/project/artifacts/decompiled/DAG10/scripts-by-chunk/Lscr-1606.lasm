on PlaySound SoundFile, Important
  [  0] pushzero ................................ <0>
  [  1] setlocal 0 .............................. AvChan = 0
  [  3] pushint8 1 .............................. <1>
  [  6] setlocal 8
  [  8] getlocal 8
  [ 10] pushint8 4 .............................. <4>
  [ 13] lteq
  [ 14] jmpifz [ 46] ............................ repeat with i = 1 to 4
  [ 17] getlocal 8 .............................. <i>
  [ 19] pusharglist 1 ........................... <i>
  [ 21] extcall 3 ............................... <soundBusy(i)>
  [ 23] pushzero ................................ <0>
  [ 24] eq ...................................... <soundBusy(i) = 0>
  [ 25] jmpifz [ 35] ............................ if soundBusy(i) = 0 then
  [ 28] getlocal 8 .............................. <i>
  [ 30] setlocal 0 .............................. AvChan = i
  [ 32] jmp [ 46] ............................... exit repeat
  [ 35] pushint8 1
  [ 38] getlocal 8
  [ 40] add
  [ 41] setlocal 8
  [ 43] endrepeat [  8]
  [ 46] getlocal 0 .............................. <AvChan>
  [ 48] pushzero ................................ <0>
  [ 49] eq ...................................... <AvChan = 0>
  [ 50] getparam 8 .............................. <Important>
  [ 52] pushint8 1 .............................. <1>
  [ 55] eq ...................................... <Important = 1>
  [ 56] and ..................................... <(AvChan = 0) and (Important = 1)>
  [ 57] jmpifz [ 69] ............................ if (AvChan = 0) and (Important = 1) then
  [ 60] pushint8 4 .............................. <4>
  [ 63] pusharglist 1 ........................... <4>
  [ 65] extcall 6 ............................... <random(4)>
  [ 67] setlocal 0 .............................. AvChan = random(4)
  [ 69] getlocal 0 .............................. <AvChan>
  [ 71] pushzero ................................ <0>
  [ 72] gt ...................................... <AvChan > 0>
  [ 73] jmpifz [ 84] ............................ if AvChan > 0 then
  [ 76] getlocal 0 .............................. <AvChan>
  [ 78] getparam 0 .............................. <SoundFile>
  [ 80] pusharglistnoret 2 ...................... <AvChan, SoundFile>
  [ 82] extcall 2 ............................... puppetSound(AvChan, SoundFile)
  [ 84] ret
end
