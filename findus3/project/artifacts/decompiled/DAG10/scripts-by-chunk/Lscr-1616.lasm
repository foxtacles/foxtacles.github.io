on exitFrame
  [  0] pushzero ................................ <0>
  [  1] setglobal 254 ........................... flash = 0
  [  4] pushint8 1 .............................. <1>
  [  7] setglobal 255 ........................... FirstTime = 1
  [ 10] pushint8 2 .............................. <2>
  [ 13] pushint8 255 ............................ <255>
  [ 16] pushint8 1 .............................. <1>
  [ 19] set 4 ................................... set the volume of sound 2 to 255
  [ 21] pushint8 9 .............................. <9>
  [ 24] pusharglistnoret 1 ...................... <9>
  [ 26] extcall 253 ............................. puppetTransition(9)
  [ 29] pushcons 0 .............................. <"rim">
  [ 31] pusharglistnoret 1 ...................... <"rim">
  [ 33] extcall 2 ............................... puppetSound("rim")
  [ 35] ret
end
