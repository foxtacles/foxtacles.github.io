  [ 18] jmp [ 59]
  [ 21] peek 0
  [ 23] pushint8 2 .............................. <2>
  [ 26] eq
  [ 27] jmpifz [ 38] ............................ (case) 2:
  [ 30] pusharglistnoret 0 ...................... <>
