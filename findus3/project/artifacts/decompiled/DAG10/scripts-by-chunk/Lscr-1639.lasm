on UNIfixCastSimple ObjectNr
  [  0] getglobal 1 ............................. <UNIObjectList>
  [  2] getparam 0 .............................. <ObjectNr>
  [  4] pusharglist 2 ........................... <UNIObjectList, ObjectNr>
  [  6] extcall 45 .............................. <getAt(UNIObjectList, ObjectNr)>
  [  9] setlocal 0 .............................. tObj = getAt(UNIObjectList, ObjectNr)
  [ 11] getlocal 0 .............................. <tObj>
  [ 13] getobjprop 7 ............................ <tObj.UNIstartCastNr>
  [ 15] setlocal 8 .............................. firstPic = tObj.UNIstartCastNr
  [ 17] getlocal 0 .............................. <tObj>
  [ 19] getobjprop 21 ........................... <tObj.UNIpicsPerAngle>
  [ 21] setlocal 16 ............................. numberOfPics = tObj.UNIpicsPerAngle
  [ 23] getlocal 0 .............................. <tObj>
  [ 25] getobjprop 27 ........................... <tObj.UNIaktPic>
  [ 27] setlocal 24 ............................. thisPic = tObj.UNIaktPic
  [ 29] getlocal 24 ............................. <thisPic>
  [ 31] getlocal 8 .............................. <firstPic>
  [ 33] getlocal 16 ............................. <numberOfPics>
  [ 35] add ..................................... <firstPic + numberOfPics>
  [ 36] pushint8 1 .............................. <1>
  [ 39] sub ..................................... <firstPic + numberOfPics - 1>
  [ 40] eq ...................................... <thisPic = (firstPic + numberOfPics - 1)>
  [ 41] jmpifz [ 51] ............................ if thisPic = (firstPic + numberOfPics - 1) then / else
  [ 44] getlocal 8 .............................. <firstPic>
  [ 46] setlocal 24 ............................. thisPic = firstPic
  [ 48] jmp [ 59]
  [ 51] getlocal 24 ............................. <thisPic>
  [ 53] pushint8 1 .............................. <1>
  [ 56] add ..................................... <thisPic + 1>
  [ 57] setlocal 24 ............................. thisPic = thisPic + 1
  [ 59] getlocal 0 .............................. <tObj>
  [ 61] getlocal 24 ............................. <thisPic>
  [ 63] setobjprop 27 ........................... tObj.UNIaktPic = thisPic
  [ 65] ret
end
