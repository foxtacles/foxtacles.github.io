on exitFrame
  [  0] pushint8 4 .............................. <4>
  [  3] pusharglistnoret 1 ...................... <4>
  [  5] extcall 67 .............................. cursor(4)
  [  8] pushint8 1 .............................. <1>
  [ 11] pushcons 0 .............................. <"kalender">
  [ 13] pusharglistnoret 2 ...................... <1, "kalender">
  [ 15] extcall 11 .............................. go(1, "kalender")
  [ 17] ret
end
