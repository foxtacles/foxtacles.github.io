global gBorja

on beginSprite me
  [  0] getparam 0 .............................. <me>
  [  2] getobjprop 76 ........................... <me.spriteNum>
  [  5] setglobal 74 ............................ gBorja = me.spriteNum
  [  8] ret
end

on exitFrame me
  [  0] pusharglistnoret 0 ...................... <>
  [  2] extcall 68 .............................. knappar()
  [  5] ret
end

on mouseEnter me
  [  0] pushint8 192 ............................ <192>
  [  3] pushint8 193 ............................ <193>
  [  6] pusharglist 2 ........................... <[192, 193]>
  [  8] pushlist ................................ <[192, 193]>
  [  9] pusharglistnoret 1 ...................... <[192, 193]>
  [ 11] extcall 67 .............................. cursor([192, 193])
  [ 14] ret
end

on mouseLeave me
  [  0] pushint8 1 .............................. <1>
  [  3] inv ..................................... <-1>
  [  4] pusharglistnoret 1 ...................... <-1>
  [  6] extcall 67 .............................. cursor(-1)
  [  9] ret
end

on mouseDown me
  [  0] pushint8 1 .............................. <1>
  [  3] inv ..................................... <-1>
  [  4] pusharglistnoret 1 ...................... <-1>
  [  6] extcall 67 .............................. cursor(-1)
  [  9] ret
end
