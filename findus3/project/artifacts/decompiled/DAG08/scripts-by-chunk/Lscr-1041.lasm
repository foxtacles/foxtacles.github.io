on exitFrame
  [  0] pushzero ................................ <0>
  [  1] setglobal 16 ............................ flash = 0
  [  3] pushint8 1 .............................. <1>
  [  6] setglobal 78 ............................ FirstTime = 1
  [  9] pushint8 2 .............................. <2>
  [ 12] pushint8 255 ............................ <255>
  [ 15] pushint8 1 .............................. <1>
  [ 18] set 4 ................................... set the volume of sound 2 to 255
  [ 20] pushint8 9 .............................. <9>
  [ 23] pusharglistnoret 1 ...................... <9>
  [ 25] extcall 69 .............................. puppetTransition(9)
  [ 28] pushcons 0 .............................. <"rim">
  [ 30] pusharglistnoret 1 ...................... <"rim">
  [ 32] extcall 17 .............................. puppetSound("rim")
  [ 34] pushcons 8 .............................. <"dikt">
  [ 36] pusharglistnoret 1 ...................... <"dikt">
  [ 38] extcall 11 .............................. go("dikt")
  [ 40] ret
end
