on broms
  [  0] pusharglist 0 ........................... <>
  [  2] thebuiltin 1 ............................ <the ticks>
  [  4] setlocal 0 .............................. tid = the ticks
  [  6] pusharglist 0 ........................... <>
  [  8] thebuiltin 1 ............................ <the ticks>
  [ 10] getlocal 0 .............................. <tid>
  [ 12] pushint8 2 .............................. <2>
  [ 14] add ..................................... <tid + 2>
  [ 15] lt ...................................... <the ticks < (tid + 2)>
  [ 16] jmpifz [ 21] ............................ repeat while the ticks < (tid + 2)
  [ 19] endrepeat [  6]
  [ 21] ret
end

on stopp
  [  0] pusharglist 0 ........................... <>
  [  2] thebuiltin 1 ............................ <the ticks>
  [  4] setlocal 0 .............................. tid = the ticks
  [  6] pusharglist 0 ........................... <>
  [  8] thebuiltin 1 ............................ <the ticks>
  [ 10] getlocal 0 .............................. <tid>
  [ 12] pushint8 6 .............................. <6>
  [ 14] add ..................................... <tid + 6>
  [ 15] lt ...................................... <the ticks < (tid + 6)>
  [ 16] jmpifz [ 21] ............................ repeat while the ticks < (tid + 6)
  [ 19] endrepeat [  6]
  [ 21] ret
end
