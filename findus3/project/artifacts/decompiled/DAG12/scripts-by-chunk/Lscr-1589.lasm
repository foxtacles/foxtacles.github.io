on gameStage5
  [  0] pusharglistnoret 0 ...................... <>
  [  2] extcall 102 ............................. setOutSprites2()
  [  5] pushint8 2 .............................. <2>
  [  8] pushcons 0 .............................. <"F604">
  [ 10] pusharglistnoret 2 ...................... <2, "F604">
  [ 12] extcall 89 .............................. puppetSound(2, "F604")
  [ 15] getglobal 36 ............................ <gameStage>
  [ 18] pushcons 8 .............................. <0.5>
  [ 20] add ..................................... <gameStage + 0.5>
