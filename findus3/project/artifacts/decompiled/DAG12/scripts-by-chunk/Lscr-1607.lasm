on exitFrame
  [  0] pushint8 1 .............................. <1>
  [  3] setglobal 238 ........................... OkAttAvsluta = 1
  [  6] pushint8 2 .............................. <2>
  [  9] pushint8 255 ............................ <255>
  [ 12] pushint8 1 .............................. <1>
  [ 15] set 4 ................................... set the volume of sound 2 to 255
  [ 17] pushint8 9 .............................. <9>
  [ 20] pusharglistnoret 1 ...................... <9>
  [ 22] extcall 228 ............................. puppetTransition(9)
  [ 25] pushcons 0 .............................. <"rim">
  [ 27] pusharglistnoret 1 ...................... <"rim">
  [ 29] extcall 89 .............................. puppetSound("rim")
  [ 32] pushint8 2 .............................. <2>
  [ 35] pusharglistnoret 1 ...................... <2>
  [ 37] extcall 55 .............................. go(2)
  [ 40] ret
end
