on UNIfixCastSimple ObjectNr
  [  0] getglobal 1 ............................. <UNIObjectList>
  [  2] getparam 0 .............................. <ObjectNr>
  [  4] pusharglist 2 ........................... <UNIObjectList, ObjectNr>
  [  6] extcall 43 .............................. <getAt(UNIObjectList, ObjectNr)>
  [  9] setlocal 0 .............................. tObj = getAt(UNIObjectList, ObjectNr)
  [ 11] getlocal 0 .............................. <tObj>
  [ 13] getobjprop 7 ............................ <tObj.UNIstartCastNr>
  [ 15] setlocal 8 .............................. firstPic = tObj.UNIstartCastNr
  [ 17] getlocal 0 .............................. <tObj>
  [ 19] getobjprop 23 ........................... <tObj.UNIpicsPerAngle>
  [ 21] setlocal 16 ............................. numberOfPics = tObj.UNIpicsPerAngle
  [ 23] getlocal 0 .............................. <tObj>
  [ 25] getobjprop 173 .......................... <tObj.UNIaktPic>
  [ 28] setlocal 24 ............................. thisPic = tObj.UNIaktPic
  [ 30] getlocal 24 ............................. <thisPic>
  [ 32] getlocal 8 .............................. <firstPic>
  [ 34] getlocal 16 ............................. <numberOfPics>
  [ 36] add ..................................... <firstPic + numberOfPics>
  [ 37] pushint8 1 .............................. <1>
  [ 40] sub ..................................... <firstPic + numberOfPics - 1>
  [ 41] eq ...................................... <thisPic = (firstPic + numberOfPics - 1)>
  [ 42] jmpifz [ 52] ............................ if thisPic = (firstPic + numberOfPics - 1) then / else
  [ 45] getlocal 8 .............................. <firstPic>
  [ 47] setlocal 24 ............................. thisPic = firstPic
  [ 49] jmp [ 60]
  [ 52] getlocal 24 ............................. <thisPic>
  [ 54] pushint8 1 .............................. <1>
  [ 57] add ..................................... <thisPic + 1>
  [ 58] setlocal 24 ............................. thisPic = thisPic + 1
  [ 60] getlocal 0 .............................. <tObj>
  [ 62] getlocal 24 ............................. <thisPic>
  [ 64] setobjprop 173 .......................... tObj.UNIaktPic = thisPic
  [ 67] ret
end
