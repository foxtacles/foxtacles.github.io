on Wait
  [  0] pushint8 1 .............................. <1>
  [  3] pusharglist 1 ........................... <1>
  [  5] extcall 87 .............................. <soundBusy(1)>
  [  8] pushint8 2 .............................. <2>
  [ 11] pusharglist 1 ........................... <2>
  [ 13] extcall 87 .............................. <soundBusy(2)>
  [ 16] or ...................................... <soundBusy(1) or soundBusy(2)>
  [ 17] getglobal 31 ............................ <UNIObjectList>
  [ 19] pusharglist 1 ........................... <UNIObjectList>
  [ 21] extcall 73 .............................. <count(UNIObjectList)>
  [ 24] pushzero ................................ <0>
  [ 25] gt ...................................... <count(UNIObjectList) > 0>
  [ 26] or ...................................... <soundBusy(1) or soundBusy(2) or (count(UNIObjectList) > 0)>
  [ 27] getglobal 30 ............................ <holdStage>
  [ 29] pushint8 1 .............................. <1>
  [ 32] eq ...................................... <holdStage = 1>
  [ 33] or ...................................... <soundBusy(1) or soundBusy(2) or (count(UNIObjectList) > 0) or (holdStage = 1)>
  [ 34] jmpifz [ 45] ............................ if soundBusy(1) or soundBusy(2) or (count(UNIObjectList) > 0) or (holdStage = 1) then / else
  [ 37] pusharglistnoret 0 ...................... <>
  [ 39] extcall 60 .............................. return 
  [ 42] jmp [ 59]
  [ 45] getglobal 36 ............................ <gameStage>
  [ 48] pushcons 0 .............................. <0.5>
  [ 50] add ..................................... <gameStage + 0.5>
  [ 51] pusharglist 1 ........................... <gameStage + 0.5>
  [ 53] extcall 88 .............................. <integer(gameStage + 0.5)>
  [ 56] setglobal 36 ............................ gameStage = integer(gameStage + 0.5)
  [ 59] ret
end
