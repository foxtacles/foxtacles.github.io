on mouseUp
  [  0] pushint8 10 ............................. <10>
  [  2] setlocal 0
  [  4] getlocal 0
  [  6] pushint8 15 ............................. <15>
  [  8] lteq
  [  9] jmpifz [ 28] ............................ repeat with i = 10 to 15
  [ 12] getlocal 0 .............................. <i>
  [ 14] pushzero ................................ <0>
  [ 15] pusharglistnoret 2 ...................... <i, 0>
  [ 17] extcall 10 .............................. puppetSprite(i, 0)
  [ 19] pushint8 1
  [ 21] getlocal 0
  [ 23] add
  [ 24] setlocal 0
  [ 26] endrepeat [  4]
  [ 28] pushcons 0 .............................. <"init">
  [ 30] pusharglistnoret 1 ...................... <"init">
  [ 32] extcall 1 ............................... go("init")
  [ 34] ret
end
