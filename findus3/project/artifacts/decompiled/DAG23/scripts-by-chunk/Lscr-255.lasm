global gSoundCount

on checkSound
  [  0] pushint8 1 .............................. <1>
  [  2] pusharglist 1 ........................... <1>
  [  4] extcall 85 .............................. <soundBusy(1)>
  [  6] not ..................................... <not soundBusy(1)>
  [  7] jmpifz [ 48] ............................ if not soundBusy(1) then
  [ 10] pushint8 131 ............................ <131>
  [ 13] pushint8 149 ............................ <149>
  [ 16] pusharglistnoret 2 ...................... <131, 149>
  [ 18] extcall 99 .............................. unloadMember(131, 149)
  [ 20] pushcons 0 .............................. <"dans_ljud">
  [ 22] getglobal 86 ............................ <gSoundCount>
  [ 24] joinstr ................................. <"dans_ljud" & gSoundCount>
  [ 25] pusharglistnoret 1 ...................... <"dans_ljud" & gSoundCount>
  [ 27] extcall 83 .............................. puppetSound("dans_ljud" & gSoundCount)
  [ 29] getglobal 86 ............................ <gSoundCount>
  [ 31] pushint8 1 .............................. <1>
  [ 33] add ..................................... <gSoundCount + 1>
  [ 34] setglobal 86 ............................ gSoundCount = gSoundCount + 1
  [ 36] getglobal 86 ............................ <gSoundCount>
  [ 38] pushint8 9 .............................. <9>
  [ 40] gt ...................................... <gSoundCount > 9>
  [ 41] jmpifz [ 48] ............................ if gSoundCount > 9 then
  [ 44] pushint8 1 .............................. <1>
  [ 46] setglobal 86 ............................ gSoundCount = 1
  [ 48] ret
end
