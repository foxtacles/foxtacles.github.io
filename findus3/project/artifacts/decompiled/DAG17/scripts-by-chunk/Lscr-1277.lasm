global gBorja, flash, G_ElkFirstTime

on beginSprite me
  [  0] getparam 0 .............................. <me>
  [  2] getobjprop 5 ............................ <me.spriteNum>
  [  4] setglobal 14 ............................ gBorja = me.spriteNum
  [  6] getglobal 14 ............................ <gBorja>
  [  8] pusharglist 1 ........................... <gBorja>
  [ 10] extcall 6 ............................... <sprite(gBorja)>
  [ 12] pushzero ................................ <0>
  [ 13] setobjprop 7 ............................ sprite(gBorja).blend = 0
  [ 15] ret
end

on mouseEnter me
  [  0] getglobal 14 ............................ <gBorja>
  [  2] pusharglist 1 ........................... <gBorja>
  [  4] extcall 6 ............................... <sprite(gBorja)>
  [  6] pushint8 100 ............................ <100>
  [  9] setobjprop 7 ............................ sprite(gBorja).blend = 100
  [ 11] pushint8 20 ............................. <20>
  [ 14] pushint8 21 ............................. <21>
  [ 17] pusharglist 2 ........................... <[20, 21]>
  [ 19] pushlist ................................ <[20, 21]>
  [ 20] pusharglistnoret 1 ...................... <[20, 21]>
  [ 22] extcall 18 .............................. cursor([20, 21])
  [ 24] ret
end

on mouseLeave me
  [  0] getglobal 14 ............................ <gBorja>
  [  2] pusharglist 1 ........................... <gBorja>
  [  4] extcall 6 ............................... <sprite(gBorja)>
  [  6] pushzero ................................ <0>
  [  7] setobjprop 7 ............................ sprite(gBorja).blend = 0
  [  9] pushint8 1 .............................. <1>
  [ 12] inv ..................................... <-1>
  [ 13] pusharglistnoret 1 ...................... <-1>
  [ 15] extcall 18 .............................. cursor(-1)
  [ 17] ret
end

on mouseDown me
  [  0] pusharglist 0 ........................... <>
  [  2] thebuiltin 3 ............................ <the mouseDown>
  [  4] getglobal 9 ............................. <flash>
  [  6] pushzero ................................ <0>
  [  7] eq ...................................... <flash = 0>
  [  8] and ..................................... <the mouseDown and (flash = 0)>
  [  9] jmpifz [ 70] ............................ if the mouseDown and (flash = 0) then
  [ 12] pushint8 1 .............................. <1>
  [ 15] inv ..................................... <-1>
  [ 16] pusharglistnoret 1 ...................... <-1>
  [ 18] extcall 18 .............................. cursor(-1)
  [ 20] pushint8 1 .............................. <1>
  [ 23] setglobal 35 ............................ G_ElkFirstTime = 1
  [ 26] pusharglist 0 ........................... <>
  [ 28] thebuiltin 3 ............................ <the mouseDown>
  [ 30] pushint8 1 .............................. <1>
  [ 33] eq ...................................... <the mouseDown = 1>
  [ 34] jmpifz [ 43] ............................ repeat while the mouseDown = 1
  [ 37] pusharglistnoret 0 ...................... <>
  [ 39] extcall 10 .............................. updateStage()
  [ 41] endrepeat [ 26]
  [ 43] pushint8 1 .............................. <1>
  [ 46] pushzero ................................ <0>
  [ 47] pusharglistnoret 2 ...................... <1, 0>
  [ 49] extcall 12 .............................. puppetSound(1, 0)
  [ 51] getglobal 14 ............................ <gBorja>
  [ 53] pusharglist 1 ........................... <gBorja>
  [ 55] extcall 6 ............................... <sprite(gBorja)>
  [ 57] pushzero ................................ <0>
  [ 58] setobjprop 7 ............................ sprite(gBorja).blend = 0
  [ 60] pusharglistnoret 0 ...................... <>
  [ 62] extcall 10 .............................. updateStage()
  [ 64] pushcons 0 .............................. <"spielen">
  [ 66] pusharglistnoret 1 ...................... <"spielen">
  [ 68] extcall 13 .............................. go("spielen")
  [ 70] ret
end
