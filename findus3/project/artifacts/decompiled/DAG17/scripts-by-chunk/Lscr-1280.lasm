on exitFrame
  [  0] pushzero ................................ <0>
  [  1] setglobal 9 ............................. flash = 0
  [  3] pushint8 1 .............................. <1>
  [  6] setglobal 34 ............................ FirstTime = 1
  [  9] pushint8 2 .............................. <2>
  [ 12] pushint8 255 ............................ <255>
  [ 15] pushint8 1 .............................. <1>
  [ 18] set 4 ................................... set the volume of sound 2 to 255
  [ 20] pushint8 9 .............................. <9>
  [ 23] pusharglistnoret 1 ...................... <9>
  [ 25] extcall 11 .............................. puppetTransition(9)
  [ 27] pushcons 0 .............................. <"rim">
  [ 29] pusharglistnoret 1 ...................... <"rim">
  [ 31] extcall 12 .............................. puppetSound("rim")
  [ 33] ret
end
