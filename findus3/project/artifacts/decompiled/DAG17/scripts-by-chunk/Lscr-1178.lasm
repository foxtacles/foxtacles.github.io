on mouseWithin me
  [  0] getparam 0 .............................. <me>
  [  2] getobjprop 183 .......................... <me.spriteNum>
  [  5] setlocal 0 .............................. thisSprite = me.spriteNum
  [  7] pushint8 52 ............................. <52>
  [ 10] getlocal 0 .............................. <thisSprite>
  [ 12] pushint8 33 ............................. <33>
  [ 15] get 6 ................................... <the loc of sprite thisSprite>
  [ 17] pushint8 33 ............................. <33>
  [ 20] set 6 ................................... set the loc of sprite 52 to the loc of sprite thisSprite
  [ 22] ret
end

on mouseLeave
  [  0] pushint8 52 ............................. <52>
  [  3] pushint8 1000 ........................... <1000>
  [  6] inv ..................................... <-1000>
  [  7] pushint8 1000 ........................... <1000>
  [ 10] inv ..................................... <-1000>
  [ 11] pusharglist 2 ........................... <-1000, -1000>
  [ 13] extcall 39 .............................. <point(-1000, -1000)>
  [ 16] pushint8 33 ............................. <33>
  [ 19] set 6 ................................... set the loc of sprite 52 to point(-1000, -1000)
  [ 21] ret
end

on mouseUp me
  [  0] getparam 0 .............................. <me>
  [  2] getobjprop 183 .......................... <me.spriteNum>
  [  5] setlocal 0 .............................. thisSprite = me.spriteNum
  [  7] pushint8 2 .............................. <2>
  [ 10] setglobal 104 ........................... numberOfPlayers = 2
  [ 13] pushint8 2 .............................. <2>
  [ 16] setglobal 103 ........................... gameStage = 2
  [ 19] pushint8 49 ............................. <49>
  [ 22] setlocal 8
  [ 24] getlocal 8
  [ 26] pushint8 83 ............................. <83>
  [ 29] lteq
  [ 30] jmpifz [ 64] ............................ repeat with j = 49 to 83
  [ 33] getlocal 8 .............................. <j>
  [ 35] pushint8 1000 ........................... <1000>
  [ 38] inv ..................................... <-1000>
  [ 39] pushint8 1000 ........................... <1000>
  [ 42] inv ..................................... <-1000>
  [ 43] pusharglist 2 ........................... <-1000, -1000>
  [ 45] extcall 39 .............................. <point(-1000, -1000)>
  [ 48] pushint8 33 ............................. <33>
  [ 51] set 6 ................................... set the loc of sprite j to point(-1000, -1000)
  [ 53] pushint8 1
  [ 56] getlocal 8
  [ 58] add
  [ 59] setlocal 8
  [ 61] endrepeat [ 24]
  [ 64] ret
end
