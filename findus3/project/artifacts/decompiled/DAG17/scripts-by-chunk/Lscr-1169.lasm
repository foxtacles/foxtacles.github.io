on exitFrame
  [  0] getmovieprop 6 .......................... <the milliSeconds>
  [  2] getglobal 7 ............................. <oldTimer>
  [  4] pushint8 24 ............................. <24>
  [  7] add ..................................... <oldTimer + 24>
  [  8] gt ...................................... <the milliSeconds > (oldTimer + 24)>
  [  9] jmpifz [ 20] ............................ if the milliSeconds > (oldTimer + 24) then
  [ 12] getmovieprop 6 .......................... <the milliSeconds>
  [ 14] setglobal 7 ............................. oldTimer = the milliSeconds
  [ 16] pusharglistnoret 0 ...................... <>
  [ 18] extcall 8 ............................... mainLoop()
  [ 20] getglobal 9 ............................. <ballALive>
  [ 22] pushzero ................................ <0>
  [ 23] eq ...................................... <ballALive = 0>
  [ 24] getglobal 10 ............................ <ElkGameOver>
  [ 26] pushint8 1 .............................. <1>
  [ 29] eq ...................................... <ElkGameOver = 1>
  [ 30] and ..................................... <(ballALive = 0) and (ElkGameOver = 1)>
  [ 31] jmpifz [ 46] ............................ if (ballALive = 0) and (ElkGameOver = 1) then
  [ 34] pusharglistnoret 0 ...................... <>
  [ 36] extcall 11 .............................. removeBall()
  [ 38] pusharglistnoret 0 ...................... <>
  [ 40] extcall 12 .............................. updateStage()
  [ 42] pusharglistnoret 0 ...................... <>
  [ 44] extcall 13 .............................. endGame()
  [ 46] pusharglist 0 ........................... <>
  [ 48] thebuiltin 14 ........................... <the frame>
  [ 50] pusharglistnoret 1 ...................... <the frame>
  [ 52] extcall 15 .............................. go(the frame)
  [ 54] ret
end
