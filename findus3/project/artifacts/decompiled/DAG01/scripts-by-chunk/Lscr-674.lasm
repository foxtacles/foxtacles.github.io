global gFindus, gNextCP, gVarvCount

on exitFrame
  [  0] pushsymb 108 ............................ <#stop>
  [  2] pushint8 2 .............................. <2>
  [  4] pusharglistnoret 2 ...................... <2>
  [  6] extcall 109 ............................. sound stop 2
  [  8] pushzero ................................ <0>
  [  9] pusharglistnoret 1 ...................... <0>
  [ 11] extcall 64 .............................. puppetSound(0)
  [ 13] pushint8 10 ............................. <10>
  [ 15] setlocal 0 .............................. s = 10
  [ 17] getlocal 0 .............................. <s>
  [ 19] pushint8 13 ............................. <13>
  [ 21] get 6 ................................... <the locH of sprite s>
  [ 23] setlocal 8 .............................. X = the locH of sprite s
  [ 25] getlocal 0 .............................. <s>
  [ 27] pushint8 14 ............................. <14>
  [ 29] get 6 ................................... <the locV of sprite s>
  [ 31] setlocal 16 ............................. Y = the locV of sprite s
  [ 33] pushcons 0 .............................. <"findus_script">
  [ 35] pusharglist 1 ........................... <"findus_script">
  [ 37] extcall 66 .............................. <script("findus_script")>
  [ 39] getlocal 0 .............................. <s>
  [ 41] pushint8 100 ............................ <100>
  [ 43] pushint8 2 .............................. <2>
  [ 45] pushint8 41 ............................. <41>
  [ 47] getlocal 8 .............................. <X>
  [ 49] getlocal 16 ............................. <Y>
  [ 51] pusharglist 7 ........................... <script("findus_script"), s, 100, 2, 41, X, Y>
  [ 53] extcall 0 ............................... <new(script("findus_script"), s, 100, 2, 41, X, Y)>
  [ 55] setglobal 65 ............................ gFindus = new(script("findus_script"), s, 100, 2, 41, X, Y)
  [ 57] pushint8 1 .............................. <1>
  [ 59] setglobal 67 ............................ gNextCP = 1
  [ 61] pushzero ................................ <0>
  [ 62] setglobal 68 ............................ gVarvCount = 0
  [ 64] pushcons 8 .............................. <" ">
  [ 66] pushcons 16 ............................. <"tid_field">
  [ 68] pushzero ................................ <0>
  [ 69] put 22 .................................. put " " into field "tid_field"
  [ 71] pushint8 1 .............................. <1>
  [ 73] pushint8 9 .............................. <9>
  [ 75] pusharglistnoret 2 ...................... <1, 9>
  [ 77] extcall 122 ............................. unLoad(1, 9)
  [ 79] pushint8 55 ............................. <55>
  [ 81] pusharglist 1 ........................... <55>
  [ 83] extcall 117 ............................. <member(55)>
  [ 85] pusharglistnoret 1 ...................... <member(55)>
  [ 87] extcall 124 ............................. unloadMember(member(55))
  [ 89] pushint8 81 ............................. <81>
  [ 91] pusharglist 1 ........................... <81>
  [ 93] extcall 117 ............................. <member(81)>
  [ 95] pusharglistnoret 1 ...................... <member(81)>
  [ 97] extcall 124 ............................. unloadMember(member(81))
  [ 99] pushint8 100 ............................ <100>
  [101] pusharglist 1 ........................... <100>
  [103] extcall 117 ............................. <member(100)>
  [105] pushint8 123 ............................ <123>
  [107] pusharglistnoret 2 ...................... <member(100), 123>
  [109] extcall 125 ............................. preloadMember(member(100), 123)
  [111] pushint8 4 .............................. <4>
  [113] pusharglistnoret 1 ...................... <4>
  [115] extcall 69 .............................. cursor(4)
  [117] pushint8 2 .............................. <2>
  [119] pushint8 255 ............................ <255>
  [122] pushint8 1 .............................. <1>
  [124] set 4 ................................... set the volume of sound 2 to 255
  [126] pushcons 24 ............................. <"startanim">
  [128] pusharglistnoret 1 ...................... <"startanim">
  [130] extcall 70 .............................. go("startanim")
  [132] ret
end
