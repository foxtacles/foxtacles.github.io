on mouseUp
  [  0] pushint8 10 ............................. <10>
  [  2] pushzero ................................ <0>
  [  3] pusharglistnoret 2 ...................... <10, 0>
  [  5] extcall 33 .............................. puppetSprite(10, 0)
  [  7] pushcons 0 .............................. <EMPTY>
  [  9] pushcons 8 .............................. <"tid_field">
  [ 11] pushzero ................................ <0>
  [ 12] put 22 .................................. put EMPTY into field "tid_field"
  [ 14] pushcons 16 ............................. <"meny">
  [ 16] pusharglistnoret 1 ...................... <"meny">
  [ 18] extcall 70 .............................. go("meny")
  [ 20] ret
end
