global gGameTime, gBumpCount

on exitFrame
  [  0] pushint8 1 .............................. <1>
  [  2] inv ..................................... <-1>
  [  3] setglobal 82 ............................ gGameTime = -1
  [  5] pushzero ................................ <0>
  [  6] pushint8 34 ............................. <34>
  [  8] set 7 ................................... set the timer to 0
  [ 10] pushzero ................................ <0>
  [ 11] setglobal 88 ............................ gBumpCount = 0
  [ 13] pushsymb 108 ............................ <#stop>
  [ 15] pushint8 2 .............................. <2>
  [ 17] pusharglistnoret 2 ...................... <2>
  [ 19] extcall 109 ............................. sound stop 2
  [ 21] pushint8 43 ............................. <43>
  [ 23] pusharglist 1 ........................... <43>
  [ 25] extcall 117 ............................. <member(43)>
  [ 27] pushint8 48 ............................. <48>
  [ 29] pusharglistnoret 2 ...................... <member(43), 48>
  [ 31] extcall 124 ............................. unloadMember(member(43), 48)
  [ 33] ret
end
