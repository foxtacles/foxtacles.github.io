global gFindus

on doLayers
  [  0] getglobal 65 ............................ <gFindus>
  [  2] getobjprop 13 ........................... <gFindus.yPos>
  [  4] setlocal 0 .............................. yfindus = gFindus.yPos
  [  6] pushint8 20 ............................. <20>
  [  8] setlocal 8 .............................. i = 20
  [ 10] getlocal 8 .............................. <i>
  [ 12] pushint8 35 ............................. <35>
  [ 14] get 6 ................................... <the memberNum of sprite i>
  [ 16] setlocal 16 ............................. c = the memberNum of sprite i
  [ 18] getlocal 16 ............................. <c>
  [ 20] pushzero ................................ <0>
  [ 21] gt ...................................... <c > 0>
  [ 22] jmpifz [ 72] ............................ repeat while c > 0
  [ 25] getlocal 8 .............................. <i>
  [ 27] pushint8 14 ............................. <14>
  [ 29] get 6 ................................... <the locV of sprite i>
  [ 31] getlocal 0 .............................. <yfindus>
  [ 33] gt ...................................... <the locV of sprite i > yfindus>
  [ 34] jmpifz [ 48] ............................ if the locV of sprite i > yfindus then / else
  [ 37] getlocal 8 .............................. <i>
  [ 39] pushint8 1 .............................. <1>
  [ 41] pushint8 25 ............................. <25>
  [ 43] set 6 ................................... set the visible of sprite i to 1
  [ 45] jmp [ 55]
  [ 48] getlocal 8 .............................. <i>
  [ 50] pushzero ................................ <0>
  [ 51] pushint8 25 ............................. <25>
  [ 53] set 6 ................................... set the visible of sprite i to 0
  [ 55] getlocal 8 .............................. <i>
  [ 57] pushint8 1 .............................. <1>
  [ 59] add ..................................... <i + 1>
  [ 60] setlocal 8 .............................. i = i + 1
  [ 62] getlocal 8 .............................. <i>
  [ 64] pushint8 35 ............................. <35>
  [ 66] get 6 ................................... <the memberNum of sprite i>
  [ 68] setlocal 16 ............................. c = the memberNum of sprite i
  [ 70] endrepeat [ 18]
  [ 72] ret
end
