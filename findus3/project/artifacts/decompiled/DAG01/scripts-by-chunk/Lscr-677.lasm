global gCPRects

on exitFrame
  [  0] pushint8 52 ............................. <52>
  [  3] pusharglist 1 ........................... <52>
  [  5] extcall 137 ............................. <sprite(52)>
  [  8] pushzero ................................ <0>
  [  9] setobjprop 138 .......................... sprite(52).visible = 0
  [ 12] pusharglist 0 ........................... <>
  [ 14] extcall 26 .............................. <list()>
  [ 16] setglobal 83 ............................ gCPRects = list()
  [ 19] pushint8 11 ............................. <11>
  [ 22] setlocal 0 .............................. i = 11
  [ 24] getlocal 0 .............................. <i>
  [ 26] pushint8 35 ............................. <35>
  [ 29] get 6 ................................... <the memberNum of sprite i>
  [ 31] setlocal 8 .............................. c = the memberNum of sprite i
  [ 33] getlocal 8 .............................. <c>
  [ 35] pushzero ................................ <0>
  [ 36] gt ...................................... <c > 0>
  [ 37] jmpifz [ 74] ............................ repeat while c > 0
  [ 40] getglobal 83 ............................ <gCPRects>
  [ 43] getlocal 0 .............................. <i>
  [ 45] pushint8 34 ............................. <34>
  [ 48] get 6 ................................... <the rect of sprite i>
  [ 50] pusharglistnoret 2 ...................... <gCPRects, the rect of sprite i>
  [ 52] extcall 28 .............................. add(gCPRects, the rect of sprite i)
  [ 54] getlocal 0 .............................. <i>
  [ 56] pushint8 1 .............................. <1>
  [ 59] add ..................................... <i + 1>
  [ 60] setlocal 0 .............................. i = i + 1
  [ 62] getlocal 0 .............................. <i>
  [ 64] pushint8 35 ............................. <35>
  [ 67] get 6 ................................... <the memberNum of sprite i>
  [ 69] setlocal 8 .............................. c = the memberNum of sprite i
  [ 71] endrepeat [ 33]
  [ 74] pushint8 40 ............................. <40>
  [ 77] pusharglist 1 ........................... <40>
  [ 79] extcall 137 ............................. <sprite(40)>
  [ 82] pushzero ................................ <0>
  [ 83] setobjprop 138 .......................... sprite(40).visible = 0
  [ 86] pushint8 41 ............................. <41>
  [ 89] pusharglist 1 ........................... <41>
  [ 91] extcall 137 ............................. <sprite(41)>
  [ 94] pushzero ................................ <0>
  [ 95] setobjprop 138 .......................... sprite(41).visible = 0
  [ 98] pushcons 0 .............................. <EMPTY>
  [100] pushcons 8 .............................. <"tid_field">
  [102] pushzero ................................ <0>
  [103] put 22 .................................. put EMPTY into field "tid_field"
  [105] ret
end
