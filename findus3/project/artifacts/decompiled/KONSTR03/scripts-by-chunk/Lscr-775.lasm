on ChangeToStage SpritNr
  [  0] getparam 0 .............................. <SpritNr>
  [  2] pushint8 20 ............................. <20>
  [  4] eq ...................................... <SpritNr = 20>
  [  5] jmpifz [ 17] ............................ if SpritNr = 20 then
  [  8] getparam 0 .............................. <SpritNr>
  [ 10] pushint8 415 ............................ <415>
  [ 13] pushint8 4 .............................. <4>
  [ 15] set 6 ................................... set the castNum of sprite SpritNr to 415
  [ 17] getparam 0 .............................. <SpritNr>
  [ 19] pushint8 30 ............................. <30>
  [ 21] eq ...................................... <SpritNr = 30>
  [ 22] jmpifz [ 34] ............................ if SpritNr = 30 then
  [ 25] getparam 0 .............................. <SpritNr>
  [ 27] pushint8 480 ............................ <480>
  [ 30] pushint8 4 .............................. <4>
  [ 32] set 6 ................................... set the castNum of sprite SpritNr to 480
  [ 34] getparam 0 .............................. <SpritNr>
  [ 36] pushint8 22 ............................. <22>
  [ 38] eq ...................................... <SpritNr = 22>
  [ 39] jmpifz [ 51] ............................ if SpritNr = 22 then
  [ 42] getparam 0 .............................. <SpritNr>
  [ 44] pushint8 421 ............................ <421>
  [ 47] pushint8 4 .............................. <4>
  [ 49] set 6 ................................... set the castNum of sprite SpritNr to 421
