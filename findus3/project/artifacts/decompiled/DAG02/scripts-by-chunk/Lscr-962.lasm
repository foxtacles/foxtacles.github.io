on exitFrame
  [  0] pushint8 1 .............................. <1>
  [  3] setlocal 0
  [  5] getlocal 0
  [  7] pushint8 48 ............................. <48>
  [ 10] lteq
  [ 11] jmpifz [ 32] ............................ repeat with i = 1 to 48
  [ 14] getlocal 0 .............................. <i>
  [ 16] pushzero ................................ <0>
  [ 17] pusharglistnoret 2 ...................... <i, 0>
  [ 19] extcall 49 .............................. puppetSprite(i, 0)
  [ 22] pushint8 1
  [ 25] getlocal 0
  [ 27] add
  [ 28] setlocal 0
  [ 30] endrepeat [  5]
  [ 32] pushcons 0 .............................. <EMPTY>
  [ 34] pushint8 3 .............................. <3>
  [ 37] set 0 ................................... set the keyDownScript to EMPTY
  [ 39] pusharglistnoret 0 ...................... <>
  [ 41] extcall 27 .............................. feedback()
  [ 43] ret
end
