global gBorja, flash

on beginSprite me
  [  0] getparam 0 .............................. <me>
  [  2] getobjprop 53 ........................... <me.spriteNum>
  [  5] setglobal 58 ............................ gBorja = me.spriteNum
  [  8] getglobal 58 ............................ <gBorja>
  [ 11] pusharglist 1 ........................... <gBorja>
  [ 13] extcall 54 .............................. <sprite(gBorja)>
  [ 16] pushzero ................................ <0>
  [ 17] setobjprop 55 ........................... sprite(gBorja).blend = 0
  [ 20] ret
end

on mouseEnter me
  [  0] getglobal 58 ............................ <gBorja>
  [  3] pusharglist 1 ........................... <gBorja>
  [  5] extcall 54 .............................. <sprite(gBorja)>
  [  8] pushint8 100 ............................ <100>
  [ 11] setobjprop 55 ........................... sprite(gBorja).blend = 100
  [ 14] pushint8 300 ............................ <300>
  [ 17] pushint8 301 ............................ <301>
  [ 20] pusharglist 2 ........................... <[300, 301]>
  [ 22] pushlist ................................ <[300, 301]>
  [ 23] pusharglistnoret 1 ...................... <[300, 301]>
  [ 25] extcall 62 .............................. cursor([300, 301])
  [ 28] ret
end

on mouseLeave me
  [  0] getglobal 58 ............................ <gBorja>
  [  3] pusharglist 1 ........................... <gBorja>
  [  5] extcall 54 .............................. <sprite(gBorja)>
  [  8] pushzero ................................ <0>
  [  9] setobjprop 55 ........................... sprite(gBorja).blend = 0
  [ 12] pushint8 1 .............................. <1>
  [ 15] inv ..................................... <-1>
  [ 16] pusharglistnoret 1 ...................... <-1>
  [ 18] extcall 62 .............................. cursor(-1)
  [ 21] ret
end

on mouseDown me
  [  0] pusharglist 0 ........................... <>
  [  2] thebuiltin 4 ............................ <the mouseDown>
  [  4] getglobal 57 ............................ <flash>
  [  7] pushzero ................................ <0>
  [  8] eq ...................................... <flash = 0>
  [  9] and ..................................... <the mouseDown and (flash = 0)>
  [ 10] jmpifz [101] ............................ if the mouseDown and (flash = 0) then
  [ 13] pushint8 1 .............................. <1>
  [ 16] inv ..................................... <-1>
  [ 17] pusharglistnoret 1 ...................... <-1>
  [ 19] extcall 62 .............................. cursor(-1)
  [ 22] pushint8 1 .............................. <1>
  [ 25] pushzero ................................ <0>
  [ 26] pusharglistnoret 2 ...................... <1, 0>
  [ 28] extcall 10 .............................. puppetSound(1, 0)
  [ 30] pusharglist 0 ........................... <>
  [ 32] thebuiltin 4 ............................ <the mouseDown>
  [ 34] pushint8 1 .............................. <1>
  [ 37] eq ...................................... <the mouseDown = 1>
  [ 38] jmpifz [ 47] ............................ repeat while the mouseDown = 1
  [ 41] pusharglistnoret 0 ...................... <>
  [ 43] extcall 8 ............................... updateStage()
  [ 45] endrepeat [ 30]
  [ 47] getglobal 58 ............................ <gBorja>
  [ 50] pusharglist 1 ........................... <gBorja>
  [ 52] extcall 54 .............................. <sprite(gBorja)>
  [ 55] pushzero ................................ <0>
  [ 56] setobjprop 55 ........................... sprite(gBorja).blend = 0
  [ 59] pusharglistnoret 0 ...................... <>
  [ 61] extcall 8 ............................... updateStage()
  [ 63] pushint8 1 .............................. <1>
  [ 66] setlocal 0
  [ 68] getlocal 0
  [ 70] pushint8 48 ............................. <48>
  [ 73] lteq
  [ 74] jmpifz [ 94] ............................ repeat with i = 1 to 48
  [ 77] getlocal 0 .............................. <i>
  [ 79] pushzero ................................ <0>
  [ 80] pusharglistnoret 2 ...................... <i, 0>
  [ 82] extcall 2 ............................... puppetSprite(i, 0)
  [ 84] pushint8 1
  [ 87] getlocal 0
  [ 89] add
  [ 90] setlocal 0
  [ 92] endrepeat [ 68]
  [ 94] pushcons 0 .............................. <"spielen">
  [ 96] pusharglistnoret 1 ...................... <"spielen">
  [ 98] extcall 32 .............................. go("spielen")
  [101] ret
end
