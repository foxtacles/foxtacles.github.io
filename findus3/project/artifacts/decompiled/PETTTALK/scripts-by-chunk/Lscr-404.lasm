on exitFrame
  [  0] pushcons 0 .............................. <"NyAvsn:">
  [  2] getglobal 36 ............................ <NyAvsnitt>
  [  5] pusharglistnoret 2 ...................... <"NyAvsn:", NyAvsnitt>
  [  7] extcall 31 .............................. put "NyAvsn:", NyAvsnitt
  [  9] getglobal 36 ............................ <NyAvsnitt>
  [ 12] pushint8 1 .............................. <1>
  [ 15] eq ...................................... <NyAvsnitt = 1>
  [ 16] jmpifz [ 29] ............................ if NyAvsnitt = 1 then
  [ 19] pushint8 1 .............................. <1>
  [ 22] pushcons 8 .............................. <"PINTRO">
  [ 24] pusharglistnoret 2 ...................... <1, "PINTRO">
  [ 26] extcall 32 .............................. go(1, "PINTRO")
  [ 29] getglobal 36 ............................ <NyAvsnitt>
  [ 32] pushint8 2 .............................. <2>
  [ 35] eq ...................................... <NyAvsnitt = 2>
  [ 36] getglobal 16 ............................ <AktRitning>
  [ 38] pushzero ................................ <0>
  [ 39] gt ...................................... <AktRitning > 0>
  [ 40] and ..................................... <(NyAvsnitt = 2) and (AktRitning > 0)>
  [ 41] jmpifz [ 91] ............................ if (NyAvsnitt = 2) and (AktRitning > 0) then
  [ 44] getglobal 16 ............................ <AktRitning>
  [ 46] pusharglist 1 ........................... <AktRitning>
  [ 48] extcall 40 .............................. <string(AktRitning)>
  [ 51] setlocal 0 .............................. Kstr = string(AktRitning)
  [ 53] getlocal 0 .............................. <Kstr>
  [ 55] pusharglist 1 ........................... <Kstr>
  [ 57] extcall 41 .............................. <length(Kstr)>
  [ 60] pushint8 1 .............................. <1>
  [ 63] eq ...................................... <length(Kstr) = 1>
  [ 64] jmpifz [ 74] ............................ if length(Kstr) = 1 then
  [ 67] pushcons 16 ............................. <"0">
  [ 69] getlocal 0 .............................. <Kstr>
  [ 71] joinstr ................................. <"0" & Kstr>
  [ 72] setlocal 0 .............................. Kstr = "0" & Kstr
  [ 74] pushcons 24 ............................. <"KONSTR">
  [ 76] getlocal 0 .............................. <Kstr>
  [ 78] joinstr ................................. <"KONSTR" & Kstr>
  [ 79] setlocal 0 .............................. Kstr = "KONSTR" & Kstr
  [ 81] pushint8 1 .............................. <1>
  [ 84] getlocal 0 .............................. <Kstr>
  [ 86] pusharglistnoret 2 ...................... <1, Kstr>
  [ 88] extcall 32 .............................. go(1, Kstr)
  [ 91] ret
end
