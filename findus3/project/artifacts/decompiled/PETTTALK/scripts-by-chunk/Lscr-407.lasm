global gKalender, flash, gkalenderintro

on beginSprite me
  [  0] getparam 0 .............................. <me>
  [  2] getobjprop 53 ........................... <me.spriteNum>
  [  5] setglobal 52 ............................ gKalender = me.spriteNum
  [  8] getglobal 52 ............................ <gKalender>
  [ 11] pusharglist 1 ........................... <gKalender>
  [ 13] extcall 54 .............................. <sprite(gKalender)>
  [ 16] pushzero ................................ <0>
  [ 17] setobjprop 55 ........................... sprite(gKalender).blend = 0
  [ 20] ret
end

on mouseEnter me
  [  0] getglobal 52 ............................ <gKalender>
  [  3] pusharglist 1 ........................... <gKalender>
  [  5] extcall 54 .............................. <sprite(gKalender)>
  [  8] pushint8 100 ............................ <100>
  [ 11] setobjprop 55 ........................... sprite(gKalender).blend = 100
  [ 14] pushint8 300 ............................ <300>
  [ 17] pushint8 301 ............................ <301>
  [ 20] pusharglist 2 ........................... <[300, 301]>
  [ 22] pushlist ................................ <[300, 301]>
  [ 23] pusharglistnoret 1 ...................... <[300, 301]>
  [ 25] extcall 62 .............................. cursor([300, 301])
  [ 28] ret
end

on mouseLeave me
  [  0] getglobal 52 ............................ <gKalender>
  [  3] pusharglist 1 ........................... <gKalender>
  [  5] extcall 54 .............................. <sprite(gKalender)>
  [  8] pushzero ................................ <0>
  [  9] setobjprop 55 ........................... sprite(gKalender).blend = 0
  [ 12] pushint8 1 .............................. <1>
  [ 15] inv ..................................... <-1>
  [ 16] pusharglistnoret 1 ...................... <-1>
  [ 18] extcall 62 .............................. cursor(-1)
  [ 21] ret
end

on mouseDown me
  [  0] pusharglist 0 ........................... <>
  [  2] thebuiltin 4 ............................ <the mouseDown>
  [  4] getglobal 57 ............................ <flash>
  [  7] pushzero ................................ <0>
  [  8] eq ...................................... <flash = 0>
  [  9] and ..................................... <the mouseDown and (flash = 0)>
  [ 10] jmpifz [100] ............................ if the mouseDown and (flash = 0) then
  [ 13] pushint8 1 .............................. <1>
  [ 16] inv ..................................... <-1>
  [ 17] pusharglistnoret 1 ...................... <-1>
  [ 19] extcall 62 .............................. cursor(-1)
  [ 22] pusharglist 0 ........................... <>
  [ 24] thebuiltin 4 ............................ <the mouseDown>
  [ 26] pushint8 1 .............................. <1>
  [ 29] eq ...................................... <the mouseDown = 1>
  [ 30] jmpifz [ 39] ............................ repeat while the mouseDown = 1
  [ 33] pusharglistnoret 0 ...................... <>
  [ 35] extcall 8 ............................... updateStage()
  [ 37] endrepeat [ 22]
  [ 39] pushint8 9 .............................. <9>
  [ 42] setlocal 0
  [ 44] getlocal 0
  [ 46] pushint8 25 ............................. <25>
  [ 49] lteq
  [ 50] jmpifz [ 74] ............................ repeat with i = 9 to 25
  [ 53] getlocal 0 .............................. <i>
  [ 55] pusharglist 1 ........................... <i>
  [ 57] extcall 54 .............................. <sprite(i)>
  [ 60] pushzero ................................ <0>
  [ 61] setobjprop 55 ........................... sprite(i).blend = 0
  [ 64] pushint8 1
  [ 67] getlocal 0
  [ 69] add
  [ 70] setlocal 0
  [ 72] endrepeat [ 44]
  [ 74] pushint8 10 ............................. <10>
  [ 77] pusharglistnoret 1 ...................... <10>
  [ 79] extcall 14 .............................. puppetTransition(10)
  [ 81] pushint8 1 .............................. <1>
  [ 84] pushzero ................................ <0>
  [ 85] pusharglistnoret 2 ...................... <1, 0>
  [ 87] extcall 10 .............................. puppetSound(1, 0)
  [ 89] pushzero ................................ <0>
  [ 90] setglobal 76 ............................ gkalenderintro = 0
  [ 93] pushcons 0 .............................. <"spelslut">
  [ 95] pusharglistnoret 1 ...................... <"spelslut">
  [ 97] extcall 32 .............................. go("spelslut")
  [100] ret
end
