on exitFrame
  [  0] getglobal 76 ............................ <gkalenderintro>
  [  3] pushint8 1 .............................. <1>
  [  6] eq ...................................... <gkalenderintro = 1>
  [  7] jmpifz [ 20] ............................ if gkalenderintro = 1 then / else
  [ 10] pushcons 0 .............................. <"spielen">
  [ 12] pusharglistnoret 1 ...................... <"spielen">
  [ 14] extcall 32 .............................. go("spielen")
  [ 17] jmp [ 82]
  [ 20] pushint8 1 .............................. <1>
  [ 23] setglobal 76 ............................ gkalenderintro = 1
  [ 26] pushint8 54 ............................. <54>
  [ 29] pusharglist 1 ........................... <54>
  [ 31] extcall 54 .............................. <sprite(54)>
  [ 34] pushint8 100 ............................ <100>
  [ 37] setobjprop 55 ........................... sprite(54).blend = 100
  [ 40] pushzero ................................ <0>
  [ 41] setglobal 57 ............................ flash = 0
  [ 44] pushint8 1 .............................. <1>
  [ 47] setglobal 74 ............................ FirstTime = 1
  [ 50] pushint8 1 .............................. <1>
  [ 53] setglobal 16 ............................ AktRitning = 1
  [ 55] pushint8 2 .............................. <2>
  [ 58] pushint8 255 ............................ <255>
  [ 61] pushint8 1 .............................. <1>
  [ 64] set 4 ................................... set the volume of sound 2 to 255
  [ 66] pushint8 9 .............................. <9>
  [ 69] pusharglistnoret 1 ...................... <9>
  [ 71] extcall 14 .............................. puppetTransition(9)
  [ 73] pushint8 1 .............................. <1>
  [ 76] pushcons 8 .............................. <"rim">
  [ 78] pusharglistnoret 2 ...................... <1, "rim">
  [ 80] extcall 10 .............................. puppetSound(1, "rim")
  [ 82] ret
end
