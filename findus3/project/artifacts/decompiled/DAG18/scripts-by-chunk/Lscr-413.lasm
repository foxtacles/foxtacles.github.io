  [ 29] get 9 ................................... <the number of member "nickbak">
  [ 31] pushint8 4 .............................. <4>
  [ 34] set 6 ................................... set the castNum of sprite Knapp to the number of member "nickbak"
  [ 36] jmp [ 54]
  [ 39] getlocal 0 .............................. <Knapp>
  [ 41] pushcons 8 .............................. <"bak\x8Ct">
  [ 43] pushzero ................................ <0>
