on exitFrame
  [  0] pushint8 14 ............................. <14>
  [  3] pusharglist 1 ........................... <14>
  [  5] extcall 4 ............................... <sprite(14)>
  [  7] pushint8 1 .............................. <1>
  [ 10] setobjprop 5 ............................ sprite(14).visible = 1
  [ 12] pushint8 8 .............................. <8>
  [ 15] pusharglist 1 ........................... <8>
  [ 17] extcall 4 ............................... <sprite(8)>
  [ 19] pushzero ................................ <0>
  [ 20] setobjprop 5 ............................ sprite(8).visible = 0
  [ 22] pushcons 0 .............................. <"tre">
  [ 24] pusharglistnoret 1 ...................... <"tre">
  [ 26] extcall 9 ............................... go("tre")
  [ 28] ret
end
