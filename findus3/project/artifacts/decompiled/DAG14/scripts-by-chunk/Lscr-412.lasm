  [ 36] pusharglist 1 ........................... <70>
  [ 38] extcall 6 ............................... <sprite(70)>
  [ 40] pushzero ................................ <0>
  [ 41] setobjprop 7 ............................ sprite(70).visible = 0
  [ 43] pushint8 2 .............................. <2>
  [ 46] pushint8 1 .............................. <1>
  [ 49] get 4 ................................... <the volume of sound 2>
  [ 51] setlocal 0 .............................. volym = the volume of sound 2
  [ 53] getlocal 0 .............................. <volym>
  [ 55] pushint8 100 ............................ <100>
  [ 58] lt ...................................... <volym < 100>
  [ 59] jmpifz [ 94] ............................ repeat while volym < 100
  [ 62] getlocal 0 .............................. <volym>
  [ 64] pushint8 10 ............................. <10>
  [ 67] add ..................................... <volym + 10>
  [ 68] setlocal 0 .............................. volym = volym + 10
  [ 70] pushint8 2 .............................. <2>
  [ 73] getlocal 0 .............................. <volym>
  [ 75] pusharglist 1 ........................... <volym>
  [ 77] extcall 25 .............................. <integer(volym)>
  [ 79] pushint8 1 .............................. <1>
  [ 82] set 4 ................................... set the volume of sound 2 to integer(volym)
  [ 84] pushint8 6 .............................. <6>
