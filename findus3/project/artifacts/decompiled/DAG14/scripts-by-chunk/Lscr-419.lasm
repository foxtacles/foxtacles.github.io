on exitFrame
  [  0] pushzero ................................ <0>
  [  1] setglobal 10 ............................ ove = 0
  [  3] pushint8 15 ............................. <15>
  [  6] pusharglistnoret 1 ...................... <15>
  [  8] extcall 23 .............................. puppetTempo(15)
