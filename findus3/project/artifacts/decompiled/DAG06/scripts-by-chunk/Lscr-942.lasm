on exitFrame
  [  0] pusharglist 0 ........................... <>
  [  2] thebuiltin 25 ........................... <the frame>
  [  4] pusharglistnoret 1 ...................... <the frame>
  [  6] extcall 24 .............................. go(the frame)
  [  8] ret
end

on keyDown
  [  0] pusharglist 0 ........................... <>
  [  2] thebuiltin 43 ........................... <the key>
  [  4] pushcons 0 .............................. <RETURN>
  [  6] eq ...................................... <the key = RETURN>
  [  7] jmpifz [ 44] ............................ if the key = RETURN then
  [ 10] pushint8 1 .............................. <1>
  [ 12] setlocal 0
  [ 14] getlocal 0
  [ 16] pushint8 12 ............................. <12>
  [ 18] lteq
  [ 19] jmpifz [ 38] ............................ repeat with n = 1 to 12
  [ 22] getlocal 0 .............................. <n>
  [ 24] pushzero ................................ <0>
  [ 25] pusharglistnoret 2 ...................... <n, 0>
  [ 27] extcall 11 .............................. puppetSprite(n, 0)
  [ 29] pushint8 1
  [ 31] getlocal 0
  [ 33] add
  [ 34] setlocal 0
  [ 36] endrepeat [ 14]
  [ 38] pushint8 6 .............................. <6>
  [ 40] pusharglistnoret 1 ...................... <6>
  [ 42] extcall 24 .............................. go(6)
  [ 44] ret
end
