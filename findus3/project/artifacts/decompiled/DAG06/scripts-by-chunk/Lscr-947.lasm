on mouseUp
  [  0] pushint8 1 .............................. <1>
  [  2] setlocal 0
  [  4] getlocal 0
  [  6] pushint8 12 ............................. <12>
  [  8] lteq
  [  9] jmpifz [ 28] ............................ repeat with n = 1 to 12
  [ 12] getlocal 0 .............................. <n>
  [ 14] pushzero ................................ <0>
  [ 15] pusharglistnoret 2 ...................... <n, 0>
  [ 17] extcall 11 .............................. puppetSprite(n, 0)
  [ 19] pushint8 1
  [ 21] getlocal 0
  [ 23] add
  [ 24] setlocal 0
  [ 26] endrepeat [  4]
  [ 28] pushint8 6 .............................. <6>
  [ 30] pusharglistnoret 1 ...................... <6>
  [ 32] extcall 24 .............................. go(6)
  [ 34] ret
end
