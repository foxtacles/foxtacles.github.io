on exitFrame
  if field("tot") < 500 then
    put "prova skidor.." into field "rank"
  end if
  if field("tot") > 500 then
    put "första åkturen på julklappen?" into field "rank"
  end if
  if field("tot") > 1500 then
    put "snökedja" into field "rank"
  end if
  if field("tot") > 2500 then
    put "Backens svar på Loket" into field "rank"
  end if
  if field("tot") > 3500 then
    put "pistens skräck" into field "rank"
  end if
  if field("tot") > 4500 then
    put "bigjumpets konung" into field "rank"
  end if
  if field("tot") > 5500 then
    put "akta er!" into field "rank"
  end if
  if field("tot") > 7500 then
    put "äkta snowboardare" into field "rank"
  end if
  if field("tot") > 15500 then
    put "halfpipen nästa" into field "rank"
  end if
  if field("tot") > 22500 then
    put "en kung på snö" into field "rank"
  end if
  if field("tot") > 35500 then
    put "glänsande brädan" into field "rank"
  end if
  if field("tot") > 57500 then
    put "superduperåkare" into field "rank"
  end if
  if field("tot") > 75500 then
    put "tip top man!" into field "rank"
  end if
  if field("tot") > 135500 then
    put "Backman himself!" into field "rank"
  end if
  if field("tot") > 500000 then
    put "fusk!!!" into field "rank"
  end if
  if field("tot") > 700000 then
    put "jättefusk!!!" into field "rank"
  end if
end
