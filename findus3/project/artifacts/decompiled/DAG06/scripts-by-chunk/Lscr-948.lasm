on exitFrame
  [  0] pushcons 0 .............................. <"startt">
  [  2] pusharglistnoret 1 ...................... <"startt">
  [  4] extcall 24 .............................. go("startt")
  [  6] pushint8 3 .............................. <3>
  [  8] setlocal 0
  [ 10] getlocal 0
  [ 12] pushint8 10 ............................. <10>
  [ 14] lteq
  [ 15] jmpifz [ 34] ............................ repeat with n = 3 to 10
  [ 18] getlocal 0 .............................. <n>
  [ 20] pushzero ................................ <0>
  [ 21] pusharglistnoret 2 ...................... <n, 0>
  [ 23] extcall 11 .............................. puppetSprite(n, 0)
  [ 25] pushint8 1
  [ 27] getlocal 0
  [ 29] add
  [ 30] setlocal 0
  [ 32] endrepeat [ 10]
  [ 34] ret
end
