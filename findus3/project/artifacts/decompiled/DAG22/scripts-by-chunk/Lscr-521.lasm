global gAntalPynt, gPyntSprite, gFarg

on exitFrame
  [  0] pushint8 1 .............................. <1>
  [  2] setlocal 0
  [  4] getlocal 0
  [  6] getglobal 2 ............................. <gAntalPynt>
  [  8] lteq
  [  9] jmpifz [ 34] ............................ repeat with i = 1 to gAntalPynt
  [ 12] getlocal 0 .............................. <i>
  [ 14] getglobal 1 ............................. <gPyntSprite>
  [ 16] add ..................................... <i + gPyntSprite>
  [ 17] pushint8 1 .............................. <1>
  [ 19] sub ..................................... <i + gPyntSprite - 1>
  [ 20] pushzero ................................ <0>
  [ 21] pusharglistnoret 2 ...................... <i + gPyntSprite - 1, 0>
  [ 23] extcall 3 ............................... puppetSprite(i + gPyntSprite - 1, 0)
  [ 25] pushint8 1
  [ 27] getlocal 0
  [ 29] add
  [ 30] setlocal 0
  [ 32] endrepeat [  4]
  [ 34] pushcons 0 .............................. <"init">
  [ 36] pusharglistnoret 1 ...................... <"init">
  [ 38] extcall 7 ............................... go("init")
  [ 40] ret
end
