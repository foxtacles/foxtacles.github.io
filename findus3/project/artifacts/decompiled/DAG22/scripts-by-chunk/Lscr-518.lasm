  [ 15] getglobal 2 ............................. <gAntalPynt>
  [ 17] add ..................................... <gPyntSprite + gAntalPynt>
  [ 18] lt ...................................... <n < (gPyntSprite + gAntalPynt)>
  [ 19] and ..................................... <(n >= gPyntSprite) and (n < (gPyntSprite + gAntalPynt))>
  [ 20] jmpifz [166] ............................ if (n >= gPyntSprite) and (n < (gPyntSprite + gAntalPynt)) then
  [ 23] getlocal 0 .............................. <n>
  [ 25] pushint8 35 ............................. <35>
  [ 27] get 6 ................................... <the memberNum of sprite n>
  [ 29] pushint8 20 ............................. <20>
  [ 31] mod ..................................... <the memberNum of sprite n mod 20>
  [ 32] setlocal 8 .............................. idx = the memberNum of sprite n mod 20
  [ 34] getlocal 0 .............................. <n>
  [ 36] pushcons 0 .............................. <"pynt1">
  [ 38] pushzero ................................ <0>
  [ 39] pushint8 10 ............................. <10>
  [ 41] get 9 ................................... <the number of member "pynt1">
  [ 43] pushint8 20 ............................. <20>
  [ 45] getglobal 4 ............................. <gFarg>
  [ 47] mul ..................................... <20 * gFarg>
  [ 48] add ..................................... <the number of member "pynt1" + (20 * gFarg)>
  [ 49] getlocal 8 .............................. <idx>
  [ 51] add ..................................... <the number of member "pynt1" + (20 * gFarg) + idx>
  [ 52] pushint8 1 .............................. <1>
  [ 54] sub ..................................... <the number of member "pynt1" + (20 * gFarg) + idx - 1>
  [ 55] pushint8 35 ............................. <35>
  [ 57] set 6 ................................... set the memberNum of sprite n to the number of member "pynt1" + (20 * gFarg) + idx - 1
  [ 59] pushint8 1 .............................. <1>
  [ 61] setlocal 16 ............................. allaFargade = 1
  [ 63] getglobal 1 ............................. <gPyntSprite>
  [ 65] setlocal 24
  [ 67] getlocal 24
  [ 69] getglobal 1 ............................. <gPyntSprite>
  [ 71] getglobal 2 ............................. <gAntalPynt>
  [ 73] add ..................................... <gPyntSprite + gAntalPynt>
  [ 74] pushint8 1 .............................. <1>
  [ 76] sub ..................................... <gPyntSprite + gAntalPynt - 1>
  [ 77] lteq
  [ 78] jmpifz [111] ............................ repeat with i = gPyntSprite to gPyntSprite + gAntalPynt - 1
  [ 81] getlocal 24 ............................. <i>
  [ 83] pushint8 35 ............................. <35>
  [ 85] get 6 ................................... <the memberNum of sprite i>
  [ 87] pushint8 40 ............................. <40>
  [ 89] lt ...................................... <the memberNum of sprite i < 40>
  [ 90] getlocal 24 ............................. <i>
  [ 92] getlocal 0 .............................. <n>
  [ 94] nteq .................................... <i <> n>
  [ 95] and ..................................... <(the memberNum of sprite i < 40) and (i <> n)>
  [ 96] jmpifz [102] ............................ if (the memberNum of sprite i < 40) and (i <> n) then
  [ 99] pushzero ................................ <0>
  [100] setlocal 16 ............................. allaFargade = 0
  [102] pushint8 1
  [104] getlocal 24
  [106] add
  [107] setlocal 24
  [109] endrepeat [ 67]
  [111] getlocal 16 ............................. <allaFargade>
  [113] jmpifz [166] ............................ if allaFargade then
  [116] getglobal 27 ............................ <gAllaFargadeCount>
  [118] pushzero ................................ <0>
  [119] lteq .................................... <gAllaFargadeCount <= 0>
  [120] jmpifz [159] ............................ if gAllaFargadeCount <= 0 then
  [123] pusharglistnoret 0 ...................... <>
  [125] extcall 24 .............................. updateStage()
  [127] pushint8 1 .............................. <1>
  [129] pusharglist 1 ........................... <1>
  [131] extcall 25 .............................. <soundBusy(1)>
  [133] jmpifz [142] ............................ repeat while soundBusy(1)
  [136] pusharglistnoret 0 ...................... <>
  [138] extcall 24 .............................. updateStage()
  [140] endrepeat [127]
  [142] pushcons 8 .............................. <"Dag22fk">
  [144] pushint8 3 .............................. <3>
  [146] pusharglist 1 ........................... <3>
  [148] extcall 22 .............................. <random(3)>
  [150] joinstr ................................. <"Dag22fk" & random(3)>
  [151] pusharglistnoret 1 ...................... <"Dag22fk" & random(3)>
  [153] extcall 21 .............................. puppetSound("Dag22fk" & random(3))
  [155] pushint8 5 .............................. <5>
  [157] setglobal 27 ............................ gAllaFargadeCount = 5
  [159] getglobal 27 ............................ <gAllaFargadeCount>
  [161] pushint8 1 .............................. <1>
  [163] sub ..................................... <gAllaFargadeCount - 1>
  [164] setglobal 27 ............................ gAllaFargadeCount = gAllaFargadeCount - 1
  [166] ret
