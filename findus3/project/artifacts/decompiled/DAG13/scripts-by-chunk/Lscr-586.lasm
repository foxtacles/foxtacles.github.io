  [ 61] pushint8 35 ............................. <35>
  [ 63] set 6 ................................... set the memberNum of sprite tupp to member("hona" & random(3)).memberNum
  [ 65] pusharglistnoret 0 ...................... <>
  [ 67] extcall 29 .............................. updateStage()
  [ 69] pusharglist 0 ........................... <>
  [ 71] thebuiltin 87 ........................... <the ticks>
  [ 73] setlocal 8 .............................. tid = the ticks
  [ 75] pusharglist 0 ........................... <>
  [ 77] thebuiltin 87 ........................... <the ticks>
  [ 79] getlocal 8 .............................. <tid>
  [ 81] pushint8 8 .............................. <8>
  [ 83] add ..................................... <tid + 8>
  [ 84] lt ...................................... <the ticks < (tid + 8)>
  [ 85] jmpifz [125] ............................ repeat while the ticks < (tid + 8)
  [ 88] pusharglist 0 ........................... <>
  [ 90] thebuiltin 75 ........................... <the mouseDown>
  [ 92] jmpifz [123] ............................ if the mouseDown then
  [ 95] pushzero ................................ <0>
  [ 96] pusharglistnoret 1 ...................... <0>
  [ 98] extcall 28 .............................. puppetSound(0)
  [100] getlocal 0 .............................. <tupp>
  [102] pushzero ................................ <0>
