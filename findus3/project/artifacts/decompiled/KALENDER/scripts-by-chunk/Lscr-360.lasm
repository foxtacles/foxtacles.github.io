global decDate

on checkDate
  [  0] pusharglist 0 ........................... <>
  [  2] thebuiltin 53 ........................... <the systemDate>
  [  5] getobjprop 57 ........................... <(the systemDate).month>
  [  8] setlocal 0 .............................. currentMonth = (the systemDate).month
  [ 10] getlocal 0 .............................. <currentMonth>
  [ 12] peek 0 .................................. case currentMonth of
  [ 14] pushint8 12 ............................. <12>
  [ 17] eq
  [ 18] jmpifz [ 55] ............................ (case) 12:
  [ 21] pusharglist 0 ........................... <>
  [ 23] thebuiltin 53 ........................... <the systemDate>
  [ 26] getobjprop 56 ........................... <(the systemDate).day>
  [ 29] setlocal 8 .............................. currentday = (the systemDate).day
  [ 31] getlocal 8 .............................. <currentday>
  [ 33] pushint8 25 ............................. <25>
  [ 36] lt ...................................... <currentday < 25>
  [ 37] jmpifz [ 47] ............................ if currentday < 25 then / else
  [ 40] getlocal 8 .............................. <currentday>
  [ 42] setglobal 2 ............................. decDate = currentday
  [ 44] jmp [ 52]
  [ 47] pushint8 25 ............................. <25>
  [ 50] setglobal 2 ............................. decDate = 25
  [ 52] jmp [ 95]
  [ 55] peek 0
  [ 57] pushint8 9 .............................. <9>
  [ 60] nteq
  [ 61] jmpifz [ 82] ............................ (case) 9, ...
  [ 64] peek 0
  [ 66] pushint8 10 ............................. <10>
  [ 69] nteq
  [ 70] jmpifz [ 82] ............................ (case) ..., 10, ...
  [ 73] peek 0
  [ 75] pushint8 11 ............................. <11>
  [ 78] eq
  [ 79] jmpifz [ 90] ............................ (case) ..., 11:
  [ 82] pushint8 1 .............................. <1>
  [ 85] setglobal 2 ............................. decDate = 1
  [ 87] jmp [ 95] ............................... (case) otherwise:
  [ 90] pushint8 25 ............................. <25>
  [ 93] setglobal 2 ............................. decDate = 25
  [ 95] pop 1 ................................... end case
  [ 97] ret
end
