  [ 49] endrepeat [ 16]
  [ 51] pushcons 0 .............................. <"rim">
  [ 53] pusharglistnoret 1 ...................... <"rim">
  [ 55] extcall 54 .............................. puppetSound("rim")
  [ 57] pushint8 9 .............................. <9>
  [ 59] pusharglistnoret 1 ...................... <9>
