global gTileSprite, gTileCast

on exitFrame
  [  0] pushint8 10 ............................. <10>
  [  2] setglobal 9 ............................. gTileSprite = 10
  [  4] pushint8 45 ............................. <45>
  [  6] setglobal 10 ............................ gTileCast = 45
  [  8] pusharglistnoret 0 ...................... <>
  [ 10] extcall 6 ............................... clear_tiles()
  [ 12] pushint8 3 .............................. <3>
  [ 14] pushint8 100 ............................ <100>
  [ 16] pushint8 10 ............................. <10>
  [ 18] pushint8 73 ............................. <73>
  [ 20] pushint8 289 ............................ <289>
  [ 23] pushint8 82 ............................. <82>
  [ 25] pusharglistnoret 6 ...................... <3, 100, 10, 73, 289, 82>
  [ 27] extcall 0 ............................... init_game(3, 100, 10, 73, 289, 82)
  [ 29] pushint8 8 .............................. <8>
  [ 31] pushzero ................................ <0>
  [ 32] pushint8 25 ............................. <25>
  [ 34] set 6 ................................... set the visible of sprite 8 to 0
  [ 36] pushint8 9 .............................. <9>
  [ 38] pushzero ................................ <0>
  [ 39] pushint8 25 ............................. <25>
  [ 41] set 6 ................................... set the visible of sprite 9 to 0
  [ 43] pushcons 0 .............................. <EMPTY>
  [ 45] pushcons 8 .............................. <"time_field">
  [ 47] pushzero ................................ <0>
  [ 48] put 22 .................................. put EMPTY into field "time_field"
  [ 50] ret
end
