on exitFrame
  [  0] pushzero ................................ <0>
  [  1] pusharglistnoret 1 ...................... <0>
  [  3] extcall 10 .............................. puppetSound(0)
  [  5] pusharglistnoret 0 ...................... <>
  [  7] extcall 46 .............................. unloadMember()
  [  9] pushint8 4 .............................. <4>
  [ 11] pusharglistnoret 1 ...................... <4>
  [ 13] extcall 40 .............................. cursor(4)
  [ 15] pushint8 1 .............................. <1>
  [ 17] pushcons 0 .............................. <"kalender">
  [ 19] pusharglistnoret 2 ...................... <1, "kalender">
  [ 21] extcall 22 .............................. go(1, "kalender")
  [ 23] ret
end
