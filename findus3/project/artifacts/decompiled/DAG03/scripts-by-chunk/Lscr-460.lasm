on Wait hurmycket
  [  0] pusharglist 0 ........................... <>
  [  2] thebuiltin 25 ........................... <the ticks>
  [  4] setlocal 0 .............................. nu = the ticks
  [  6] pusharglist 0 ........................... <>
  [  8] thebuiltin 25 ........................... <the ticks>
  [ 10] getlocal 0 .............................. <nu>
  [ 12] sub ..................................... <the ticks - nu>
  [ 13] getparam 0 .............................. <hurmycket>
  [ 15] lt ...................................... <(the ticks - nu) < hurmycket>
  [ 16] jmpifz [ 21] ............................ repeat while (the ticks - nu) < hurmycket
  [ 19] endrepeat [  6]
  [ 21] ret
end

