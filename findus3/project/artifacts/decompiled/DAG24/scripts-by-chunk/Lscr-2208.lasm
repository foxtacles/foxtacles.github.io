on savePos St, En
  [  0] pusharglist 0 ........................... <[]>
  [  2] pushlist ................................ <[]>
  [  3] setlocal 0 .............................. retval = []
  [  5] getparam 0 .............................. <St>
  [  7] setlocal 8
  [  9] getlocal 8
  [ 11] getparam 8 .............................. <En>
  [ 13] lteq
  [ 14] jmpifz [ 52] ............................ repeat with n = St to En
  [ 17] getlocal 0 .............................. <retval>
  [ 19] getlocal 8 .............................. <n>
  [ 21] pusharglistnoret 2 ...................... <retval, n>
  [ 23] extcall 83 .............................. append(retval, n)
  [ 26] getlocal 0 .............................. <retval>
  [ 28] getlocal 8 .............................. <n>
  [ 30] pusharglist 1 ........................... <n>
  [ 32] extcall 4 ............................... <sprite(n)>
  [ 34] getobjprop 6 ............................ <sprite(n).loc>
  [ 36] pusharglistnoret 2 ...................... <retval, sprite(n).loc>
  [ 38] extcall 83 .............................. append(retval, sprite(n).loc)
  [ 41] pushint8 1
  [ 44] getlocal 8
  [ 46] add
  [ 47] setlocal 8
  [ 49] endrepeat [  9]
  [ 52] getlocal 0 .............................. <retval>
  [ 54] pusharglistnoret 1 ...................... <retval>
  [ 56] extcall 14 .............................. return retval
  [ 58] ret
end
