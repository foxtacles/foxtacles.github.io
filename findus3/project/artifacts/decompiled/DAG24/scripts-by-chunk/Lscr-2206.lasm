on clear
  [  0] pushint8 1 .............................. <1>
  [  3] setlocal 0
  [  5] getlocal 0
  [  7] getglobal 93 ............................ <showed>
  [ 10] pusharglist 1 ........................... <showed>
  [ 12] extcall 73 .............................. <count(showed)>
  [ 15] lteq
  [ 16] jmpifz [ 59] ............................ repeat with n = 1 to count(showed)
  [ 19] getglobal 93 ............................ <showed>
  [ 22] getlocal 0 .............................. <n>
  [ 24] pusharglist 2 ........................... <showed, n>
  [ 26] objcall 41 .............................. <showed[n]>
  [ 29] pusharglist 1 ........................... <showed[n]>
  [ 31] extcall 4 ............................... <sprite(showed[n])>
  [ 33] pushint8 1000 ........................... <1000>
  [ 36] inv ..................................... <-1000>
  [ 37] pushint8 1000 ........................... <1000>
  [ 40] inv ..................................... <-1000>
  [ 41] pusharglist 2 ........................... <-1000, -1000>
  [ 43] extcall 51 .............................. <point(-1000, -1000)>
  [ 46] setobjprop 6 ............................ sprite(showed[n]).loc = point(-1000, -1000)
  [ 48] pushint8 1
  [ 51] getlocal 0
  [ 53] add
  [ 54] setlocal 0
  [ 56] endrepeat [  5]
  [ 59] pusharglist 0 ........................... <[]>
  [ 61] pushlist ................................ <[]>
