on getStartPos SpriteNr
  [  0] getglobal 88 ............................ <startpos>
  [  3] getparam 0 .............................. <SpriteNr>
  [  5] pusharglist 2 ........................... <startpos, SpriteNr>
  [  7] extcall 12 .............................. <getOne(startpos, SpriteNr)>
  [  9] setlocal 0 .............................. a = getOne(startpos, SpriteNr)
  [ 11] getlocal 0 .............................. <a>
  [ 13] pushzero ................................ <0>
  [ 14] nteq .................................... <a <> 0>
  [ 15] jmpifz [ 36] ............................ if a <> 0 then
  [ 18] getglobal 88 ............................ <startpos>
  [ 21] getlocal 0 .............................. <a>
  [ 23] pushint8 1 .............................. <1>
  [ 26] add ..................................... <a + 1>
  [ 27] pusharglist 2 ........................... <startpos, a + 1>
  [ 29] objcall 41 .............................. <startpos[a + 1]>
  [ 32] pusharglistnoret 1 ...................... <startpos[a + 1]>
  [ 34] extcall 14 .............................. return startpos[a + 1]
  [ 36] pushint8 1000 ........................... <1000>
  [ 39] inv ..................................... <-1000>
  [ 40] pushint8 1000 ........................... <1000>
  [ 43] inv ..................................... <-1000>
  [ 44] pusharglist 2 ........................... <-1000, -1000>
  [ 46] extcall 51 .............................. <point(-1000, -1000)>
  [ 49] pusharglistnoret 1 ...................... <point(-1000, -1000)>
  [ 51] extcall 14 .............................. return point(-1000, -1000)
  [ 53] ret
end
