on test p, V
  [  0] pusharglist 0 ........................... <[]>
  [  2] pushlist ................................ <[]>
  [  3] setlocal 0 .............................. n = []
  [  5] pushint8 1 .............................. <1>
  [  8] setlocal 8
  [ 10] getlocal 8
  [ 12] getparam 8 .............................. <V>
  [ 14] pusharglist 1 ........................... <V>
  [ 16] extcall 73 .............................. <count(V)>
  [ 19] lteq
  [ 20] jmpifz [ 53] ............................ repeat with m = 1 to count(V)
  [ 23] getlocal 0 .............................. <n>
  [ 25] getparam 8 .............................. <V>
  [ 27] getlocal 8 .............................. <m>
  [ 29] pusharglist 2 ........................... <V, m>
  [ 31] objcall 41 .............................. <V[m]>
  [ 34] getparam 0 .............................. <p>
  [ 36] sub ..................................... <V[m] - p>
  [ 37] pusharglistnoret 2 ...................... <n, V[m] - p>
  [ 39] extcall 83 .............................. append(n, V[m] - p)
  [ 42] pushint8 1
  [ 45] getlocal 8
  [ 47] add
  [ 48] setlocal 8
  [ 50] endrepeat [ 10]
  [ 53] getlocal 0 .............................. <n>
  [ 55] pusharglistnoret 1 ...................... <n>
  [ 57] extcall 14 .............................. return n
  [ 59] ret
end
