on StartaMaskin
  [  0] pushint8 34 ............................. <34>
  [  3] get 7 ................................... <the timer>
  [  5] getglobal 26 ............................ <WheelFrameTid>
  [  7] add ..................................... <the timer + WheelFrameTid>
  [  8] setglobal 12 ............................ WTimer = the timer + WheelFrameTid
  [ 10] pushint8 1 .............................. <1>
  [ 13] setglobal 8 ............................. MaskinAktiv = 1
  [ 15] ret
end
