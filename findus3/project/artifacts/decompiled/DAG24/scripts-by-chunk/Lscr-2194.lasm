on clicked Snr
  [  0] getparam 0 .............................. <Snr>
  [  2] setlocal 0 .............................. spnum = Snr
  [  4] getlocal 0 .............................. <spnum>
  [  6] pushzero ................................ <0>
  [  7] nteq .................................... <spnum <> 0>
  [  8] getlocal 0 .............................. <spnum>
  [ 10] getglobal 40 ............................ <startsprites>
  [ 13] pushint8 1 .............................. <1>
  [ 16] pusharglist 2 ........................... <startsprites, 1>
  [ 18] objcall 41 .............................. <startsprites[1]>
  [ 21] gt ...................................... <spnum > startsprites[1]>
  [ 22] and ..................................... <(spnum <> 0) and (spnum > startsprites[1])>
  [ 23] jmpifz [ 38] ............................ if (spnum <> 0) and (spnum > startsprites[1]) then
  [ 26] getlocal 0 .............................. <spnum>
  [ 28] pusharglist 1 ........................... <spnum>
  [ 30] extcall 4 ............................... <sprite(spnum)>
  [ 32] pushint8 500 ............................ <500>
  [ 35] setobjprop 56 ........................... sprite(spnum).locZ = 500
  [ 38] ret
end
