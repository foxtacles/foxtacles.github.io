  [ 70] getparam 0 .............................. <spnum>
  [ 72] pushint8 66 ............................. <66>
  [ 75] eq ...................................... <spnum = 66>
  [ 76] jmpifz [ 89] ............................ if spnum = 66 then
  [ 79] pushint8 2 .............................. <2>
  [ 82] pushcons 0 .............................. <"Tomte01">
  [ 84] pusharglistnoret 2 ...................... <2, "Tomte01">
  [ 86] extcall 37 .............................. puppetSound(2, "Tomte01")
  [ 89] getparam 0 .............................. <spnum>
  [ 91] pushint8 67 ............................. <67>
  [ 94] eq ...................................... <spnum = 67>
  [ 95] jmpifz [108] ............................ if spnum = 67 then
  [ 98] pushint8 2 .............................. <2>
  [101] pushcons 8 .............................. <"Tomte02">
