  [108] getparam 0 .............................. <spnum>
  [110] pushint8 68 ............................. <68>
  [113] eq ...................................... <spnum = 68>
  [114] jmpifz [127] ............................ if spnum = 68 then
  [117] pushint8 2 .............................. <2>
  [120] pushcons 16 ............................. <"Tomte03">
  [122] pusharglistnoret 2 ...................... <2, "Tomte03">
