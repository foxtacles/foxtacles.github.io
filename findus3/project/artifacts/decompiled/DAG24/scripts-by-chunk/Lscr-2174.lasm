end

on FixaGrej SpNr, Class
  [  0] getglobal 43 ............................ <TomteSprites>
  [  3] getparam 8 .............................. <Class>
  [  5] pusharglist 2 ........................... <TomteSprites, Class>
  [  7] objcall 41 .............................. <TomteSprites[Class]>
  [ 10] setlocal 0 .............................. TB = TomteSprites[Class]
  [ 12] getglobal 43 ............................ <TomteSprites>
  [ 15] getparam 8 .............................. <Class>
  [ 17] pusharglist 2 ........................... <TomteSprites, Class>
  [ 19] objcall 41 .............................. <TomteSprites[Class]>
  [ 22] pushzero ................................ <0>
  [ 23] nteq .................................... <TomteSprites[Class] <> 0>
  [ 24] jmpifz [ 57] ............................ if TomteSprites[Class] <> 0 then
  [ 27] getglobal 43 ............................ <TomteSprites>
  [ 30] getparam 8 .............................. <Class>
  [ 32] pusharglist 2 ........................... <TomteSprites, Class>
  [ 34] objcall 41 .............................. <TomteSprites[Class]>
  [ 37] pusharglist 1 ........................... <TomteSprites[Class]>
  [ 39] extcall 4 ............................... <sprite(TomteSprites[Class])>
  [ 41] getglobal 43 ............................ <TomteSprites>
  [ 44] getparam 8 .............................. <Class>
  [ 46] pusharglist 2 ........................... <TomteSprites, Class>
  [ 48] objcall 41 .............................. <TomteSprites[Class]>
  [ 51] pusharglist 1 ........................... <TomteSprites[Class]>
  [ 53] extcall 5 ............................... <getStartPos(TomteSprites[Class])>
  [ 55] setobjprop 6 ............................ sprite(TomteSprites[Class]).loc = getStartPos(TomteSprites[Class])
  [ 57] getglobal 43 ............................ <TomteSprites>
  [ 60] getparam 8 .............................. <Class>
  [ 62] getparam 0 .............................. <SpNr>
  [ 64] pusharglistnoret 3 ...................... <TomteSprites, Class, SpNr>
  [ 66] objcall 110 ............................. TomteSprites[Class] = SpNr
  [ 69] getglobal 43 ............................ <TomteSprites>
  [ 72] getlocal 0 .............................. <TB>
  [ 74] pusharglist 2 ........................... <TomteSprites, TB>
  [ 76] extcall 12 .............................. <getOne(TomteSprites, TB)>
  [ 78] setlocal 8 .............................. p = getOne(TomteSprites, TB)
  [ 80] getlocal 8 .............................. <p>
  [ 82] pushzero ................................ <0>
  [ 83] gt ...................................... <p > 0>
  [ 84] jmpifz [ 98] ............................ if p > 0 then
  [ 87] getglobal 43 ............................ <TomteSprites>
  [ 90] getlocal 8 .............................. <p>
  [ 92] pushzero ................................ <0>
  [ 93] pusharglistnoret 3 ...................... <TomteSprites, p, 0>
  [ 95] objcall 110 ............................. TomteSprites[p] = 0
  [ 98] ret
end

