on exitFrame
  global TomteSprites
  if TomteSprites[4] > 0 then
    if TomteSprites[4] = 66 then
      puppetSound(2, "Tomte01")
    end if
    if TomteSprites[4] = 67 then
      puppetSound(2, "Tomte02")
    end if
    if TomteSprites[4] = 68 then
      puppetSound(2, "Tomte03")
    end if
    if TomteSprites[4] = 69 then
      puppetSound(2, "Tomte04")
    end if
  end if
end
