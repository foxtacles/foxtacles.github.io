  [142] extcall 2 ............................... go("slut")
  [144] pusharglistnoret 0 ...................... <>
  [146] extcall 33 .............................. updateStage()
  [148] pushint8 50 ............................. <50>
  [150] pusharglistnoret 1 ...................... <50>
  [152] localcall 2 ............................. tid(50)
  [154] ret
end

on tid n
  [  0] pusharglist 0 ........................... <>
  [  2] thebuiltin 32 ........................... <the ticks>
  [  4] getparam 0 .............................. <n>
  [  6] add ..................................... <the ticks + n>
  [  7] setlocal 0 .............................. tid = the ticks + n
  [  9] getlocal 0 .............................. <tid>
  [ 11] pusharglist 0 ........................... <>
  [ 13] thebuiltin 32 ........................... <the ticks>
  [ 15] gt ...................................... <tid > the ticks>
  [ 16] jmpifz [ 35] ............................ repeat while tid > the ticks
  [ 19] pushint8 5 .............................. <5>
  [ 21] pusharglist 0 ........................... <>
  [ 23] thebuiltin 13 ........................... <the mouseH>
  [ 25] pushint8 13 ............................. <13>
  [ 27] set 6 ................................... set the locH of sprite 5 to the mouseH
  [ 29] pusharglistnoret 0 ...................... <>
  [ 31] extcall 33 .............................. updateStage()
  [ 33] endrepeat [  9]
  [ 35] ret
end
