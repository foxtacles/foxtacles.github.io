  [ 73] pushint8 30 ............................. <30>
  [ 75] add ..................................... <the locH of sprite 3 + 30>
  [ 76] pushint8 13 ............................. <13>
  [ 78] set 6 ................................... set the locH of sprite 30 to the locH of sprite 3 + 30
  [ 80] pushint8 30 ............................. <30>
  [ 82] pushint8 3 .............................. <3>
  [ 84] pushint8 14 ............................. <14>
  [ 86] get 6 ................................... <the locV of sprite 3>
  [ 88] pushint8 50 ............................. <50>
  [ 90] add ..................................... <the locV of sprite 3 + 50>
  [ 91] pushint8 14 ............................. <14>
  [ 93] set 6 ................................... set the locV of sprite 30 to the locV of sprite 3 + 50
  [ 95] pushint8 30 ............................. <30>
  [ 97] pushint8 75 ............................. <75>
  [ 99] pushint8 4 .............................. <4>
  [101] set 6 ................................... set the castNum of sprite 30 to 75
  [103] getglobal 38 ............................ <liv>
  [105] pushzero ................................ <0>
  [106] eq ...................................... <liv = 0>
  [107] jmpifz [144] ............................ if liv = 0 then
  [110] pushint8 1 .............................. <1>
  [112] setlocal 0
  [114] getlocal 0
  [116] pushint8 100 ............................ <100>
  [118] lteq
