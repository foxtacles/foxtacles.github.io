on startMovie
  [  0] pushzero ................................ <0>
  [  1] pushcons 0 .............................. <"p">
  [  3] pushzero ................................ <0>
  [  4] put 22 .................................. put 0 into field "p"
  [  6] pushint8 3 .............................. <3>
  [  8] pushint8 1 .............................. <1>
  [ 10] pushint8 5 .............................. <5>
  [ 12] set 6 ................................... set the constraint of sprite 3 to 1
  [ 14] pushint8 3 .............................. <3>
  [ 16] setglobal 10 ............................ fart = 3
  [ 18] pushint8 1 .............................. <1>
  [ 20] setglobal 7 ............................. s = 1
  [ 22] pushint8 1 .............................. <1>
  [ 24] inv ..................................... <-1>
  [ 25] setglobal 8 ............................. u = -1
  [ 27] pushint8 26 ............................. <26>
  [ 29] setlocal 0
  [ 31] getlocal 0
  [ 33] pushint8 28 ............................. <28>
  [ 35] lteq
  [ 36] jmpifz [ 56] ............................ repeat with n = 26 to 28
  [ 39] getlocal 0 .............................. <n>
  [ 41] pushint8 1 .............................. <1>
  [ 43] pushint8 25 ............................. <25>
  [ 45] set 6 ................................... set the visible of sprite n to 1
  [ 47] pushint8 1
  [ 49] getlocal 0
  [ 51] add
  [ 52] setlocal 0
  [ 54] endrepeat [ 31]
  [ 56] pushint8 3 .............................. <3>
  [ 58] setglobal 38 ............................ liv = 3
  [ 60] ret
end

on slut
  [  0] getglobal 38 ............................ <liv>
  [  2] pushint8 1 .............................. <1>
  [  4] sub ..................................... <liv - 1>
  [  5] setglobal 38 ............................ liv = liv - 1
  [  7] getglobal 38 ............................ <liv>
  [  9] pushint8 2 .............................. <2>
  [ 11] eq ...................................... <liv = 2>
  [ 12] jmpifz [ 22] ............................ if liv = 2 then
  [ 15] pushint8 26 ............................. <26>
  [ 17] pushzero ................................ <0>
  [ 18] pushint8 25 ............................. <25>
  [ 20] set 6 ................................... set the visible of sprite 26 to 0
  [ 22] getglobal 38 ............................ <liv>
  [ 24] pushint8 1 .............................. <1>
  [ 26] eq ...................................... <liv = 1>
  [ 27] jmpifz [ 37] ............................ if liv = 1 then
