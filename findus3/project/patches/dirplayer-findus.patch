+#[cfg(all(test, not(target_arch = "wasm32")))]
+mod queued_keyboard_event_tests {
+    use super::*;
+    use crate::director::lingo::datum::Datum;
+    use crate::player::{reserve_player_ref, ScriptReceiver};
+    use crate::player::testing::{run_test, TestPlayer};
+    use crate::player::symbols::symbol_table::init_symbol_table;
+
+    #[test]
+    fn queued_keys_keep_event_identity_and_live_pressed_state() {
+        init_symbol_table();
+        run_test(async {
+            let _harness = TestPlayer::new();
+            reserve_player_mut(|p| {
+                p.is_playing = true;
+                p.movie.key_down_script = Some(ScriptReceiver::ScriptText(
+                    "seenCode = the keyCode\nseenKey = the key".into()));
+                p.movie.key_up_script = p.movie.key_down_script.clone();
+                p.keyboard_manager.key_down("ArrowUp".into(), 38);
+                p.keyboard_manager.key_down("ArrowRight".into(), 39);
+            });
+            player_key_down("ArrowUp".into(), 38).await.unwrap();
+            reserve_player_ref(|p| {
+                assert_eq!(p.get_datum(p.globals.get(&Symbol::from_str("seenCode")).unwrap()).int_value().unwrap(), 126);
+                assert_eq!(p.get_datum(p.globals.get(&Symbol::from_str("seenKey")).unwrap()).string_value().unwrap(), "\u{1e}");
+                assert!(p.keyboard_manager.is_key_down("ArrowUp"));
+                assert!(p.keyboard_manager.is_key_down("ArrowRight"));
+                assert_eq!(p.keyboard_manager.key_code(), 124);
+            });
+            player_key_down("ArrowRight".into(), 39).await.unwrap();
+            reserve_player_ref(|p| assert_eq!(p.get_datum(p.globals.get(&Symbol::from_str("seenCode")).unwrap()).int_value().unwrap(), 124));
+            reserve_player_mut(|p| p.keyboard_manager.key_up("ArrowUp", 38));
+            player_key_up("ArrowUp".into(), 38).await.unwrap();
+            reserve_player_ref(|p| {
+                assert_eq!(p.get_datum(p.globals.get(&Symbol::from_str("seenCode")).unwrap()).int_value().unwrap(), 126);
+                assert!(!p.keyboard_manager.is_key_down("ArrowUp"));
+                assert!(p.keyboard_manager.is_key_down("ArrowRight"));
+                assert_eq!(p.keyboard_manager.key_pressed(), "\u{1d}");
+            });
+            // Error exits must also restore an outer event and keep live polling.
+            with_keyboard_event("Enter".into(), 13, async {
+                reserve_player_ref(|p| assert_eq!(p.keyboard_manager.key(), "\r"));
+                let failed = with_keyboard_event("ArrowLeft".into(), 37, async {
+                    reserve_player_ref(|p| assert_eq!(p.keyboard_manager.key_code(), 123));
+                    Err(ScriptError::new("fixture".into()))
+                }).await;
+                assert!(failed.is_err());
+                reserve_player_ref(|p| assert_eq!(p.keyboard_manager.key(), "\r"));
+                Ok(DatumRef::Void)
+            }).await.unwrap();
+            reserve_player_mut(|p| {
+                let code = p.get_movie_prop(Symbol::builtin(BuiltInSymbol::KeyCode)).unwrap();
+                assert!(matches!(p.get_datum(&code), Datum::Int(124)));
+            });
+        });
+    }
+}
