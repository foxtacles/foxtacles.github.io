+    fn director_rle_80_repeats_129_pixels_and_preserves_following_run() {
+        let bitmap = decompress_bitmap(&[0x80, 7, 0, 9], &indexed_info(130), 1, 700).unwrap();
+        assert_eq!(&bitmap.data[..129], &[7; 129]);
+        assert_eq!(bitmap.data[129], 9);
+    }
+
+    #[test]
+    fn compressed_literal_can_be_larger_than_decoded_pixels() {
+        let bitmap = decompress_bitmap(&[3, 11, 12, 13, 14], &indexed_info(4), 1, 700).unwrap();
+        assert_eq!(bitmap.data, vec![11, 12, 13, 14]);
