+        data: &AudioData,
+        member: &SoundMember,
+    ) -> Result<(), String> {
+        if data.compressed_data.is_some() || data.num_channels == 0
+            || data.sample_rate == 0 || data.samples.is_empty()
+        {
+            return Err("silent playback requires decoded PCM samples".into());
+        }
+        self.sample_rate = data.sample_rate;
+        self.sample_count = (data.samples.len() / data.num_channels as usize) as u32;
+        self.channel_count = data.num_channels;
+        self.sound_member = Some(member.clone());
+        self.elapsed_time = 0.0;
+        self.next_cue_index = member.cue_point_times.iter()
+            .position(|&time| time as f64 >= self.start_time)
+            .unwrap_or(member.cue_point_times.len());
+        self.status = SoundStatus::Playing;
+        *self.is_decoding.borrow_mut() = false;
+        Ok(())
