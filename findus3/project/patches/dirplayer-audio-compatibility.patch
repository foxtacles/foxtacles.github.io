+    fn step_clock_playback(&mut self, delta_seconds: f64) -> bool {
+        if self.audio_context.is_some() || self.status != SoundStatus::Playing {
+            return false;
+        }
+        self.elapsed_time += delta_seconds.max(0.0);
+        let end_ms = if self.end_time > 0.0 {
+            self.end_time.min(self.get_duration())
+        } else {
+            self.get_duration()
+        };
+        let duration = (end_ms - self.start_time).max(0.0) / 1000.0;
+        if duration <= 0.0 {
+            self.status = SoundStatus::Idle;
+            self.loops_remaining = 0;
+            return true;
+        }
+        if self.elapsed_time < duration {
+            return false;
+        }
+        if self.loop_count == 0 {
+            self.elapsed_time %= duration;
+            self.next_cue_index = 0;
+            return false;
+        }
+        let completed_loops = (self.elapsed_time / duration).floor() as i32;
+        if completed_loops < self.loops_remaining {
+            self.loops_remaining -= completed_loops;
+            self.elapsed_time %= duration;
+            self.next_cue_index = 0;
+            return false;
+        }
+        self.elapsed_time = duration;
+        self.loops_remaining = 0;
+        self.status = SoundStatus::Idle;
+        true
     }
 
