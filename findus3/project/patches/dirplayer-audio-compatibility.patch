+            "raw_pcm", Some((bytes.len() * 8 / bits as usize) as u32), big_endian).unwrap()
+    }
+
+    #[test]
+    fn unsigned_pcm8_extremes_and_silence_have_correct_polarity() {
+        assert_eq!(pcm(&[0, 1, 127, 128, 129, 255], 8, true).samples,
+            vec![-1.0, -127.0/128.0, -1.0/128.0, 0.0, 1.0/128.0, 127.0/128.0]);
+    }
+
+    #[test]
+    fn raw_pcm_prefix_is_never_discarded_as_a_resource_header() {
+        let mut bytes = vec![128; 100];
+        bytes[..2].copy_from_slice(&[0, 1]);
+        let data = pcm(&bytes, 8, true);
+        assert_eq!(data.samples.len(), 100);
+        assert_eq!(&data.samples[..3], &[-1.0, -127.0/128.0, 0.0]);
+    }
+
+    #[test]
+    fn big_endian_pcm16_preserves_order_and_sign() {
+        assert_eq!(pcm(&[0, 1, 0x80, 0, 0, 0, 0x7f, 0xff], 16, true).samples,
+            vec![1.0/32768.0, -1.0, 0.0, 32767.0/32768.0]);
+    }
+
+    #[test]
+    fn riff_size_matches_actual_bytes() {
+        let wav = SoundChannel::load_director_sound_from_bytes(&[0, 128, 255], 1,
+            22050, 8, "raw_pcm", Some(3), true).unwrap();
+        assert_eq!(u32::from_le_bytes(wav[4..8].try_into().unwrap()) as usize, wav.len() - 8);
+        assert_eq!(u32::from_le_bytes(wav[40..44].try_into().unwrap()), 6);
+    }
+
+    #[test]
+    fn malformed_wav_metadata_returns_error_without_dividing_by_zero() {
+        let mut wav = SoundChannel::load_director_sound_from_bytes(&[128, 129], 1,
+            22050, 8, "raw_pcm", Some(2), true).unwrap();
+        wav[22..24].copy_from_slice(&0u16.to_le_bytes());
+        assert!(AudioData::from_wav_bytes(&wav).is_err());
+    }
+
+    #[test]
+    fn director7_short_moa_header_and_pcm_decode_without_legacy_snd_resource() {
+        // D7's sndH is exactly 100 bytes; the later platformData block is absent.
+        let mut header_bytes = [0u8; 100];
+        for (offset, value) in [(4, 8i32), (32, 8), (36, 4), (40, 4),
+            (44, 22050), (48, 44100), (68, 16), (72, 2), (76, 1), (80, 2)] {
+            header_bytes[offset..offset+4].copy_from_slice(&value.to_be_bytes());
+        }
+        let mut reader = BinaryReader::from_u8(&header_bytes);
+        reader.endian = Endian::Big;
+        let header = SndHeaderChunk::from_reader(&mut reader).unwrap();
+        let sound = SoundChunk::from_snd_header_and_samples(&header,
+            &[0, 1, 0x80, 0, 0, 0, 0x7f, 0xff]);
+        assert_eq!((sound.channels(), sound.sample_rate(), sound.sample_count()), (1, 22050, 4));
+        assert_eq!(sound.bits_per_sample(), 16);
+        assert!(sound.big_endian_data());
+        assert_eq!(pcm(&sound.data(), sound.bits_per_sample(), sound.big_endian_data()).samples.len(), 4);
+    }
+
+    fn clock_channel(loop_count: i32) -> SoundChannel {
+        let mut channel = SoundChannel::new(0, None);
+        let member = SoundMember {
+            info: SoundInfo { sample_rate: 22050, sample_size: 8, channels: 1,
+                sample_count: 22050, ..Default::default() },
+            sound: SoundChunk::new(vec![128; 22050]),
+            cue_point_times: vec![], cue_point_names: vec![],
+        };
+        channel.set_loop_count(loop_count);
+        channel.start_clock_playback(&pcm(&vec![128; 22050], 8, true), &member).unwrap();
+        channel
+    }
+
+    #[test]
+    fn native_pcm_clock_is_busy_until_exact_sample_end() {
+        let mut channel = clock_channel(1);
+        assert!(channel.is_busy());
+        assert_eq!(channel.get_duration(), 1000.0);
+        assert!(!channel.step_clock_playback(0.25));
+        assert_eq!(channel.current_time_ms(), 250.0);
+        assert!(channel.step_clock_playback(0.75));
+        assert!(!channel.is_busy());
+        assert_eq!(channel.current_time_ms(), 1000.0);
+    }
+
+    #[test]
+    fn native_pcm_clock_counts_finite_and_infinite_loops() {
+        let mut finite = clock_channel(3);
+        assert!(!finite.step_clock_playback(2.5));
+        assert_eq!(finite.loops_remaining, 1);
+        assert_eq!(finite.current_time_ms(), 500.0);
+        assert!(finite.step_clock_playback(0.5));
+        let mut infinite = clock_channel(0);
+        assert!(!infinite.step_clock_playback(12.25));
+        assert!(infinite.is_busy());
+        assert_eq!(infinite.current_time_ms(), 250.0);
+    }
+
+    #[test]
+    fn paused_channel_retains_its_clock_and_busy_state() {
+        let mut channel = clock_channel(1);
+        channel.step_clock_playback(0.25);
+        channel.pause();
+        assert_eq!(channel.status, SoundStatus::Paused);
+        assert!(channel.is_busy());
+        assert!(!channel.step_clock_playback(100.0));
+        assert_eq!(channel.current_time_ms(), 250.0);
+        channel.resume();
+        assert!(channel.step_clock_playback(0.75));
+    }
+
+    #[test]
+    fn stop_invalidates_decodes_and_discards_queued_sounds() {
+        let mut channel = clock_channel(1);
+        *channel.is_decoding.borrow_mut() = true;
+        let generation = *channel.decode_generation.borrow();
+        channel.queued_members.push(DatumRef::Void);
+        channel.stop();
+        assert!(*channel.decode_generation.borrow() > generation);
+        assert!(!*channel.is_decoding.borrow());
+        assert!(channel.queued_members.is_empty());
+        assert!(!channel.is_busy());
+    }
+
+    #[test]
+    fn master_sound_level_and_mute_preserve_channel_volume() {
+        let mut manager = super::SoundManager::new(2).unwrap();
+        let channel = manager.get_channel(1).unwrap();
+        channel.borrow_mut().set_volume(127.5).unwrap();
+        assert_eq!(manager.sound_level(), 7);
+        assert!(manager.sound_enabled());
+        manager.set_sound_level(4);
+        assert!((channel.borrow().effective_gain() - 2.0/7.0).abs() < 1e-6);
+        manager.set_sound_enabled(false);
+        assert_eq!(channel.borrow().effective_gain(), 0.0);
+        assert_eq!(channel.borrow().volume, 127.5);
+        manager.set_sound_enabled(true);
+        assert!((channel.borrow().effective_gain() - 2.0/7.0).abs() < 1e-6);
+        manager.set_sound_level(999);
+        assert_eq!(manager.sound_level(), 7);
+        assert_eq!(channel.borrow().effective_gain(), 0.5);
+    }
+
+    #[test]
+    fn host_mute_keeps_sound_busy_and_preserves_authored_settings() {
+        let mut manager = super::SoundManager::new(1).unwrap();
+        let channel = manager.get_channel(0).unwrap();
+        *channel.borrow_mut() = clock_channel(0);
+        manager.set_sound_level(4);
+        manager.set_host_muted(true);
+        assert_eq!(channel.borrow().effective_gain(), 0.0);
+        assert!(channel.borrow().is_busy());
+        assert_eq!(manager.sound_level(), 4);
+        assert!(manager.sound_enabled());
+        manager.set_sound_level(1);
+        assert_eq!(channel.borrow().effective_gain(), 0.0);
+        manager.set_host_muted(false);
+        assert!((channel.borrow().effective_gain() - 1.0/7.0).abs() < 1e-6);
+        assert!(channel.borrow().is_busy());
+    }
+
+    #[test]
+    fn lingo_sound_busy_queries_do_not_mutate_channel_status() {
+        use crate::player::{reserve_player_mut, testing::{run_test, TestPlayer}};
+        use crate::player::handlers::types::TypeHandlers;
+        use crate::director::lingo::datum::Datum;
+        run_test(async {
+            let _player = TestPlayer::new();
+            let (argument, channel) = reserve_player_mut(|player| {
+                (player.alloc_datum(Datum::Int(1)), player.sound_manager.get_channel(0).unwrap())
+            });
+            for (status, expected) in [(SoundStatus::Loading, 1), (SoundStatus::Playing, 1),
+                (SoundStatus::Paused, 1), (SoundStatus::Idle, 0)] {
+                channel.borrow_mut().status = status.clone();
+                let result = TypeHandlers::sound_busy(&vec![argument.clone()]).unwrap();
+                reserve_player_mut(|player| {
+                    assert_eq!(player.get_datum(&result).int_value().unwrap(), expected);
+                    assert!(player.input_polled, "soundBusy loops must allow async audio callbacks");
+                });
+                assert_eq!(channel.borrow().status, status);
+            }
+        });
+    }
+
+    #[test]
+    fn pan_and_volume_round_trip_in_lingo_units() {
+        let mut channel = SoundChannel::new(0, None);
+        channel.set_pan(-25.0).unwrap();
+        channel.set_volume(127.0).unwrap();
+        assert_eq!((channel.pan, channel.volume), (-25.0, 127.0));
+        channel.set_pan(500.0).unwrap();
+        assert_eq!(channel.pan, 100.0);
+    }
+}
