@@ -11,7 +11,14 @@ namespace Common {
 
 void JSONWriter::writeString(std::string str) {
 	write("\"");
-	write(escapeString(str));
+	// JSON has neither C's \xNN nor \v escapes. Preserve legacy bytes as
+	// U+00NN; consumers can decode the resulting byte values as MacRoman.
+	for (unsigned char ch : str) {
+		if (ch == '"') write("\\\"");
+		else if (ch == '\\') write("\\\\");
+		else if (ch < 0x20 || ch >= 0x7f) write("\\u00" + byteToString(ch));
+		else write(std::string(1, static_cast<char>(ch)));
+	}
 	write("\"");
 }
 
@@ -110,9 +117,10 @@ void JSONWriter::writeNull() {
 
 void JSONWriter::writeFourCC(uint32_t val) {
 	writeValuePrefix();
-	write("\"");
-	write(fourCCToString(val));
-	write("\"");
+	std::string raw;
+	for (int shift = 24; shift >= 0; shift -= 8)
+		raw += static_cast<char>(val >> shift);
+	writeString(raw);
 	_context = kContextValue;
 	writeValueSuffix();
 }
